---
// src/layouts/Layout.astro
// Basic page shell. Keeping global resets minimal on purpose so nothing
// here fights with the per-section styles later.

import CornerIsland from '../components/CornerIsland.astro';

interface Props {
  title?: string;
}

const { title = "My CV" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <CornerIsland />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;

    /* Shared boundary colors for the page-wide sky -> sunset -> dusk
       backdrop across ArtIslandSection -> ComputerIslandSection ->
       EducationIslandSection -> AchievementIslandSection.
       Each section's gradient reuses the SAME variable at a shared
       edge (e.g. --sky-1 is both Art's bottom and Computer's top), so
       adjacent sections are guaranteed to meet at the exact same
       color — not just a close visual match — with zero risk of the
       two ever drifting apart the way hand-picked hex values in two
       different files could.
       --dusk-blue is AchievementIslandSection's bottom color, which
       now needs to match BonusIslandSection's top (BonusIslandSection
       sits between Achievement and the closing OtherIslandSection).
       This used to be an eyeballed guess off a screenshot; now that
       you've uploaded the actual bonus_island_background.png, it's
       been updated to the real sampled top-row color of that image
       (#0cd4ee) instead. */
    --sky-0: #dcf3fc; /* page top: ArtIslandSection top */
    --sky-1: #3a6ef5; /* Art bottom / Computer top seam-blend target — set to rgb(58, 110, 245) per your request */
    --sky-2: #14e5fb; /* Computer bottom / Education top seam-blend target — set to rgb(20, 229, 251) per your request */
    --sky-3: #1dedfa; /* Education bottom / Achievement top seam-blend target — set to rgb(29, 237, 250) per your request */
    --dusk-blue: #00d4f4; /* Achievement bottom / Bonus top seam-blend target — set to rgb(0, 212, 244) per your request */
    --sky-4: #04c9d1; /* Bonus bottom / Other top seam-blend target — set to rgb(4, 201, 209) per your request */

    /* --sunset-mid / --sunset-deep are no longer used — they backed
       AchievementIslandSection's old 4-stop gradient, which is now a
       real background image like the rest of the chain. Left out
       entirely rather than kept as dead variables. */
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    /* Page-level horizontal-scroll guard. This used to live as
       `overflow: hidden` on each individual flanking-island section
       (Art/Computer/Education/Achievement), clipping their
       intentionally edge-bleeding islands. That worked for the
       horizontal bleed it was meant for, but also clipped those
       islands VERTICALLY whenever one needed more room than its own
       section's box provided — the "islands cut off at the top/bottom"
       bug. Moving the horizontal clip up here means the individual
       sections no longer need `overflow: hidden` at all: horizontal
       bleed off the viewport's left/right edges is still caught here,
       but an island that overflows past its own section's top/bottom
       is now free to do so instead of being hard-clipped. */
    overflow-x: hidden;
  }

  body {
    margin: 0;
    font-family: ui-sans-serif, system-ui, sans-serif;
    background: #ffffff;
    color: #1a1a1a;
    line-height: 1.5;
  }

  /* Breathing room between sections. Every section component in this
     project (Section.astro, ArtIslandSection.astro,
     ComputerIslandSection.astro, EducationIslandSection.astro,
     AchievementIslandSection.astro, ...) renders a top-level
     `<section>`, and they're all siblings directly under `<body>` via
     `<slot />` here — so one adjacent-sibling rule here adds the gap
     between every pair of them, instead of having to repeat a
     margin/padding rule inside each section component individually.
     `section + section` only matches from the second section onward,
     so the very first section on the page stays flush with the top.
     If a section ever needs to sit flush against its neighbor on
     purpose, override with `margin-top: 0` on that specific instance
     (e.g. via a wrapper class) rather than removing this rule. */
  section + section {
    margin-top: clamp(2rem, 6vw, 5rem);
  }

  /* The 4 gradient-backed sections (ArtIslandSection,
     ComputerIslandSection, EducationIslandSection,
     AchievementIslandSection), plus BonusIslandSection and
     OtherIslandSection (both backed by real images instead of a CSS
     gradient, but part of the same continuous chain visually), all
     carry this marker class specifically so this override can zero
     out the gap rule above between them. A visible white strip from
     the rule above would show through right at each seam and break
     the continuous-sky illusion, so consecutive `.sky-chain` sections
     sit flush against each other; the gap rule still applies normally
     around any section that ISN'T part of the chain. */
  .sky-chain + .sky-chain {
    margin-top: 0;
  }

  /* Seam-blend utility classes, shared across every section in the
     `.sky-chain`. Each `cover`-cropped section can only guarantee its
     OWN edge pixel is exact on ONE of its two sides (top OR bottom,
     whichever `background-position` protects) — the other side is an
     arbitrary crop of interior content, and even on a "both sides
     protected" seam, the two different source images' true edge
     colors aren't guaranteed to match each other. Rather than trying
     to fix that at the image-crop level (which `cover` fundamentally
     can't do for more than one edge per section), these two classes
     repaint a soft gradient band at the very top/bottom of a section,
     fading between the section's own actual image and a flat,
     agreed-upon color — so regardless of what the underlying cropped
     image actually shows right at the boundary, the seam eases into
     the same color on both sides instead of hitting a hard line.
     (Tried a wave-shaped cutout here first — reverted per your
     feedback back to a plain top-to-bottom gradient blend.)

     `.seam-fade-bottom::after` paints a band at the very bottom of a
     section, fading from transparent (revealing the section's own
     image, in the middle) to solid `--seam-target-bottom` (right at
     the bottom edge). `.seam-fade-top::before` paints a matching band
     at the very TOP of the next section, fading from solid
     `--seam-target-top` (right at the top edge) back to transparent.
     On a properly paired seam both variables are set to the identical
     color, so the two fades reach the same color exactly where the
     sections meet — no hard line, just a smooth color blend on both
     sides of the seam.

     A section that needs fades on BOTH sides (e.g. ComputerIslandSection,
     sandwiched between two different seams) carries both classes and
     sets both `--seam-target-*` variables independently — they don't
     have to be the same color. `height` uses `clamp()` so the band
     stays a sensible size on both very short and very tall viewports.
     `z-index: 0` keeps this below normal in-flow content (`.content`,
     islands — all z-index 1+), and `pointer-events: none` keeps it
     from blocking anything. */
  .seam-fade-bottom,
  .seam-fade-top {
    position: relative;
  }

  .seam-fade-bottom::after,
  .seam-fade-top::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: clamp(40px, 9vh, 140px);
    z-index: 0;
    pointer-events: none;
  }

  .seam-fade-bottom::after {
    bottom: 0;
    background: linear-gradient(to bottom, transparent, var(--seam-target-bottom));
  }

  .seam-fade-top::before {
    top: 0;
    background: linear-gradient(to bottom, var(--seam-target-top), transparent);
  }
</style>