---
// src/layouts/Layout.astro
// Basic page shell. Keeping global resets minimal on purpose so nothing
// here fights with the per-section styles later.

import { ClientRouter } from 'astro:transitions';
import CornerIsland from '../components/CornerIsland.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import IslandNavMenu from '../components/IslandNavMenu.astro';
import GitHubLink from '../components/GitHubLink.astro';
import SectionTransitionOverlay from '../components/SectionTransitionOverlay.astro';
// ScrollFlickTransition.astro's own mount used to live here -- replaced
// by MobileSectionScroll.astro per your request to turn mobile
// scrolling itself into full section-to-section paging (see that
// file's own top-of-file comment for why the older, cosmetic-only
// component no longer fits alongside it). Left on disk, just unused.
import MobileSectionScroll from '../components/MobileSectionScroll.astro';

interface Props {
  title?: string;
}

// No hardcoded English fallback here any more: HomePage.astro always
// passes a `title` already resolved for the current locale (via
// src/i18n/ui.ts), so the only time this default would ever fire is
// if some future page forgets to pass one -- "My CV" was only ever
// the English string anyway, and defaulting to it regardless of
// locale would be wrong on the German/Slovenian routes.
const { title } = Astro.props;

// Astro.currentLocale is set from the URL according to the `i18n`
// config in astro.config.mjs; it can be undefined on a route i18n
// doesn't recognize (there shouldn't be one on this site, but the
// fallback keeps the <html lang> attribute valid regardless).
const htmlLang = Astro.currentLocale ?? 'en';

// import.meta.env.BASE_URL is Astro's configured `base` (see
// astro.config.mjs) -- "/personal-cv-page" for this project, with no
// trailing slash. Joining it to a public/ filename with a hardcoded
// "/" would double up if a future base value ever did end in "/", so
// this only adds one when the base doesn't already have it.
const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}${import.meta.env.BASE_URL.endsWith('/') ? '' : '/'}${path}`;
const faviconSvgHref = withBase('favicon.svg');
const faviconIcoHref = withBase('favicon.ico');
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/*
      Astro serves everything under public/ (favicon.svg, favicon.ico)
      at the configured `base` path (see astro.config.mjs), not at the
      site root. A plain "/favicon.ico" href would be missing that
      prefix and 404 in production -- worse, in dev it makes Astro's
      router log an error, because the browser's own automatic
      "/favicon.ico" request (sent on every page load when no icon
      link is present) doesn't include the base either. The hrefs are
      built from `import.meta.env.BASE_URL` up in the frontmatter
      (see `faviconSvgHref`/`faviconIcoHref`) so they always land on
      exactly one "/" between the base and the filename, however the
      configured base is written.
    */}
    <link rel="icon" type="image/svg+xml" href={faviconSvgHref} />
    <link rel="icon" type="image/x-icon" href={faviconIcoHref} />
    <title>{title}</title>
    {/*
      Enables Astro's View Transitions router: clicking the
      LanguageSwitcher's links (or any same-origin link) now does a
      soft, client-side navigation -- swapping the page content in
      place -- instead of a full browser reload. The three locale
      routes (src/pages/index.astro, /de/, /sl/) stay real, separate,
      crawlable pages; this only changes HOW the browser moves between
      them. See the bottom <script> below and every section
      component's own script for why this means DOM-attached
      listeners/observers/animation loops now need to be re-initialized
      on every navigation (via the `astro:page-load` event) rather than
      just once at parse time -- a soft navigation reuses the same
      document, so a script that only ever runs at the top level would
      otherwise go quiet after the very first language switch.
    */}
    <ClientRouter />
  </head>
  <body>
    <LanguageSwitcher />
    <IslandNavMenu />
    <GitHubLink />
    <SectionTransitionOverlay />
    <MobileSectionScroll />
    <slot />
    <CornerIsland />
    <div class="halftone-spotlight" aria-hidden="true"></div>
  </body>
</html>

<script>
  // Single, page-wide driver for the halftone cursor spotlight (see
  // `.halftone-spotlight` in the global styles below). Position
  // tracking is trivial here: the element is `position: fixed;
  // inset: 0`, so its own box IS the viewport, meaning the cursor's
  // `clientX`/`clientY` are already exactly the right coordinates —
  // no per-section bounding-rect math needed. Whether the spotlight is
  // actually visible is handled separately, in pure CSS, via
  // `body:has(.halftone-hover:hover) .halftone-spotlight` — this
  // script only ever needs to know where the cursor is, never which
  // section it's over.
  //
  // Wrapped in `astro:page-load` (fires once after the very first
  // page load, then again after every <ClientRouter /> navigation --
  // see the <head> above) instead of running directly at the top
  // level: a language switch replaces `.halftone-spotlight` with a
  // freshly-parsed element, and this module itself only ever executes
  // once, so without re-running this init on every navigation the
  // FIRST language switch would leave the spotlight permanently dead.
  // `cleanupSpotlight` tears down the previous navigation's listener
  // before attaching a new one, so switching languages back and forth
  // all session never piles up duplicate `mousemove` listeners on
  // `window` -- unlike the elements inside `<body>`, `window` itself
  // is never recreated by a soft navigation.
  let cleanupSpotlight: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    cleanupSpotlight?.();

    const spotlight = document.querySelector<HTMLElement>(".halftone-spotlight");
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (spotlight && !prefersReducedMotion) {
      const controller = new AbortController();
      window.addEventListener(
        "mousemove",
        (e) => {
          spotlight.style.setProperty("--mx", `${e.clientX}px`);
          spotlight.style.setProperty("--my", `${e.clientY}px`);
        },
        { signal: controller.signal }
      );
      cleanupSpotlight = () => controller.abort();
    }
  });
</script>

<script>
  // Keeps your scroll position when switching languages via
  // LanguageSwitcher.astro, instead of Astro's <ClientRouter />
  // default of scrolling a freshly-navigated-to page back to the top
  // (the same thing a normal browser navigation to a new page does --
  // reasonable in general, just not what you want here, since a
  // language switch is conceptually "this same page, different text,"
  // not a move to a different page).
  //
  // `astro:before-preparation` fires right as the navigation starts,
  // while you're still looking at the OLD page -- that's the last
  // moment `window.scrollY` reflects where you actually were.
  // `event.navigationType` distinguishes a normal forward navigation
  // (clicking a locale link -- "push") from the browser's own Back/
  // Forward buttons ("traverse"): only the former gets the scroll
  // position captured here and restored below, so native Back/Forward
  // scroll restoration (returning you to wherever you'd scrolled to on
  // that earlier page, which Astro already handles correctly on its
  // own) is left alone rather than overridden.
  //
  // `astro:after-swap` fires right after the new page's content has
  // replaced the old page's and Astro has applied ITS OWN default
  // scroll position -- this listener immediately overrides that with
  // the position captured above. `behavior: "instant"` skips this
  // page's `scroll-behavior: smooth` (see the global styles below) for
  // this one jump, since restoring your place should feel instant, not
  // like an animated scroll from the top.
  let scrollYBeforeNav: number | null = null;

  document.addEventListener("astro:before-preparation", (event) => {
    scrollYBeforeNav = event.navigationType === "traverse" ? null : window.scrollY;
  });

  document.addEventListener("astro:after-swap", () => {
    if (scrollYBeforeNav !== null) {
      window.scrollTo({ left: 0, top: scrollYBeforeNav, behavior: "instant" });
    }
  });
</script>

<style is:global>
  :root {
    color-scheme: light;

    /* The seam-fade system (a shared set of --sky-N / --dusk-blue /
       --intro-seam / --in-between-seam-1 boundary colors, plus the
       `.seam-fade-top`/`.seam-fade-bottom` gradient-band classes below
       that blended each section's edge into them) has been removed per
       your request — sections now meet directly, no blended band. Each
       section's own top-of-file comment still describes the OLD
       pairing history for context on why its background image was
       cropped/positioned the way it is, but the variables and classes
       themselves are gone. See the "background sizing" comment further
       down for how sections now handle their edges instead. */
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    /* Page-level horizontal-scroll guard. This used to live as
       `overflow: hidden` on each individual flanking-island section
       (Art/Computer/Education/Achievement), clipping their
       intentionally edge-bleeding islands. That worked for the
       horizontal bleed it was meant for, but also clipped those
       islands VERTICALLY whenever one needed more room than its own
       section's box provided — the "islands cut off at the top/bottom"
       bug. Moving the horizontal clip up here means the individual
       sections no longer need `overflow: hidden` at all: horizontal
       bleed off the viewport's left/right edges is still caught here,
       but an island that overflows past its own section's top/bottom
       is now free to do so instead of being hard-clipped.
       `overflow-x: hidden` alone left a sliver of white space visible
       on some mobile screens — one of the intentionally bleeding
       islands (Art's corners, Education's stack, CornerIsland, etc.)
       was pushing the page's actual scrollable width past the visible
       viewport, and `hidden` on `html` by itself doesn't always fully
       suppress that on every mobile browser. `overflow-x: clip` is a
       stricter mode that also removes the overflow from the
       scrollable area entirely (rather than just hiding a scrollbar),
       so it's added as a second line — browsers that don't support
       `clip` yet just keep using the `hidden` line above it, and ones
       that do support it get the stronger guarantee. `width: 100%`
       plus `max-width: 100vw` on `body` below closes the gap the rest
       of the way, so no descendant can widen the actual html/body box
       in the first place. */
    overflow-x: hidden;
    overflow-x: clip;
  }

  /* MobileSectionScroll.astro clamps `window.scrollY` back to the
     current section's own edge the instant you try to scroll past
     it, then plays the whip-pan to hand off to the next/previous
     section. Without this, that clamp was visibly fighting iOS
     Safari's own elastic rubber-band bounce at each section boundary
     (the page would bounce past the edge on its own, then get
     yanked back by the clamp) -- `contain` stops the browser's own
     overscroll effect (and, just as importantly, stops a spent
     scroll gesture from "chaining" past this page's own scroll
     container into browser-chrome gestures like pull-to-refresh)
     without needing MobileSectionScroll.astro to fight it frame by
     frame. Scoped to the same mobile breakpoint as that component's
     own `isMobile` check -- desktop's scroll is untouched by any of
     this. */
  @media (max-width: 640px), (max-height: 500px) and (orientation: landscape) {
    html {
      overscroll-behavior-y: contain;
    }
  }

  body {
    margin: 0;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    font-family: ui-sans-serif, system-ui, sans-serif;
    background: #ffffff;
    color: #1a1a1a;
    line-height: 1.5;
  }

  /* Breathing room between sections. Every section component in this
     project (Section.astro, ArtIslandSection.astro,
     ComputerIslandSection.astro, EducationIslandSection.astro,
     AchievementIslandSection.astro, ...) renders a top-level
     `<section>`, and they're all siblings directly under `<body>` via
     `<slot />` here — so one adjacent-sibling rule here adds the gap
     between every pair of them, instead of having to repeat a
     margin/padding rule inside each section component individually.
     `section + section` only matches from the second section onward,
     so the very first section on the page stays flush with the top.
     If a section ever needs to sit flush against its neighbor on
     purpose, override with `margin-top: 0` on that specific instance
     (e.g. via a wrapper class) rather than removing this rule. */
  section + section {
    margin-top: clamp(2rem, 6vw, 5rem);
  }

  /* The 4 gradient-backed sections (ArtIslandSection,
     ComputerIslandSection, EducationIslandSection,
     AchievementIslandSection), plus BonusIslandSection and
     OtherIslandSection (both backed by real images instead of a CSS
     gradient, but part of the same continuous chain visually), all
     carry this marker class specifically so this override can zero
     out the gap rule above between them. A visible white strip from
     the rule above would show through right at each seam and break
     the continuous-sky illusion, so consecutive `.sky-chain` sections
     sit flush against each other; the gap rule still applies normally
     around any section that ISN'T part of the chain.
     IntroIslandSection now also carries `.sky-chain` (it's the first
     section in the chain, ahead of ArtIslandSection), so this rule is
     what makes those two sit flush together too. */
  .sky-chain + .sky-chain {
    margin-top: 0;
  }

  /* Halftone cursor spotlight — a dot-grid pattern that shows around
     the cursor while it's over any `.halftone-hover` section,
     print-halftone style (inspired by the card hover effect on
     rossdraws.com/collections/tutorials).

     ONE element for the whole page (added once in the `<body>` above,
     not per-section) — this replaces an earlier per-section design
     that sized `.halftone-overlay` to each section and let it bleed
     `--halftone-radius` past that section's own edges so the circle
     wouldn't get clipped mid-shape near a boundary. That worked at
     internal seams (the next section painted over the bleed) but
     broke in two ways: the very last section's downward bleed had
     nothing to paint over it, quietly adding blank scrollable space
     to the bottom of the page; and OtherIslandSection sets its own
     `overflow-x: hidden` for its full-viewport-width breakout, which
     (per the CSS overflow spec: setting one overflow axis to non-
     visible computes the other to `auto` if it was `visible`) made
     ITS OWN `overflow-y` compute to `auto` — so unlike every other
     section, it actually clipped its own overlay's upward bleed at
     its own top edge, cutting the circle off right where it meets
     BonusIslandSection.

     This version sidesteps both bugs instead of patching around them:
     `position: fixed; inset: 0` means the element IS the viewport, not
     sized to or bounded by any section, so there's no section
     boundary left to bleed past or get clipped by, and being `fixed`
     it's out of normal flow entirely — it can never add to the page's
     scrollable height regardless of how big its mask circle is.
     `--mx`/`--my` are plain viewport coordinates, kept in sync with
     the cursor by the single script in this file (no per-section
     bounding-rect math needed any more either, since this element's
     box always starts at (0, 0) in viewport space). `mix-blend-mode:
     overlay` still blends the dots against whatever section happens
     to be underneath at that screen position — that part didn't need
     to change, blend modes don't care whether the element above is
     sized to a section or the whole viewport.

     Visibility is handled in pure CSS via `:has()` rather than a
     per-section `:hover` rule targeting a per-section child: `body:
     has(.halftone-hover:hover) .halftone-spotlight` sets opacity only
     while the cursor is over SOME `.halftone-hover` section, whichever
     one it currently is — the single spotlight element doesn't need
     to know which.

     `z-index: 0` (not something high like 9999) is deliberate: every
     island/illustration in this family (`.art-island`, `.computer-
     island`, `.education-island-*`, `.achievement-island`, and
     CornerIsland.astro's own front island) is `z-index: 1` or higher,
     and `.content` is `z-index: 2`/`3` — while each section's own
     `background-image` and the `.seam-fade-*` gradients sit at
     `z-index: 0`/auto, the same tier as this element. Since this
     `<div>` is the LAST element in the document (added after every
     section and after `<CornerIsland />`), it paints AFTER everything
     else at that z-index-0 tier — i.e. visually on top of every
     section's background and every seam-fade gradient, which is what
     lets `mix-blend-mode: overlay` actually tint them — but still
     BELOW every island and every `.content` block, which have a
     strictly higher z-index and so paint after (on top of) this
     element regardless of DOM order. Blend modes only affect what's
     already painted BEHIND an element, never what paints after it, so
     the net effect is: halftone shows on backgrounds and seam fades,
     and islands/text render normally on top, untouched. If some
     future island or foreground decoration on the page ever omits an
     explicit `z-index` (leaving it at the default `auto`, tying with
     this element), it would need one added to stay excluded — same
     requirement every other island in this family already follows. */
  .halftone-spotlight {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
    --halftone-color: #ffffff;
    --halftone-radius: 160px;
    --mx: 50vw;
    --my: 50vh;
    background-image: radial-gradient(circle, var(--halftone-color) 38%, transparent 40%);
    background-size: 10px 10px;
    mix-blend-mode: overlay;
    mask-image: radial-gradient(circle var(--halftone-radius) at var(--mx) var(--my), black 0%, black 55%, transparent 100%);
    -webkit-mask-image: radial-gradient(circle var(--halftone-radius) at var(--mx) var(--my), black 0%, black 55%, transparent 100%);
  }

  body:has(.halftone-hover:hover) .halftone-spotlight {
    opacity: 0.55;
  }

  /* ComputerIslandSection's drifting clouds layer (`.computer-clouds-
     bg`) sits at `z-index: 1`, one tier above this spotlight's normal
     `z-index: 0` — needed so those clouds also win their OWN separate
     comparison against ArtIslandSection's bleeding moon (see that
     class's own comment for the full reasoning and the rough-
     transition bug that came from trying to fix this by lowering the
     clouds to `0` instead). Left as `0` globally, that one tier gap
     means the spotlight normally paints BEHIND those clouds, hiding
     the cursor effect there specifically -- this rule bumps the
     spotlight up to tie with them, but ONLY while the cursor is
     actually over `.computer-spotlight-front` (just that section, not
     every `.halftone-hover` section site-wide, which would tie the
     spotlight with every OTHER section's islands too and start
     showing it on top of foreground art everywhere instead of just
     here). Being tied at `1` rather than winning outright is fine in
     this one case: unlike the moon/clouds pairing above, nothing on
     this side is independently animated frame-to-frame, so there's no
     repaint-order flicker for a tie to expose -- the tiebreak (DOM/
     tree order, later wins) resolves it cleanly and statically in the
     spotlight's favor, since `.halftone-spotlight` is the very last
     element in the whole document. */
  body:has(.computer-spotlight-front:hover) .halftone-spotlight {
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .halftone-spotlight {
      transition: none;
    }
  }
</style>