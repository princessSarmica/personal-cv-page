---
// src/layouts/Layout.astro
// Basic page shell. Keeping global resets minimal on purpose so nothing
// here fights with the per-section styles later.

import CornerIsland from '../components/CornerIsland.astro';

interface Props {
  title?: string;
}

const { title = "My CV" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <CornerIsland />
    <div class="halftone-spotlight" aria-hidden="true"></div>
  </body>
</html>

<script>
  // Single, page-wide driver for the halftone cursor spotlight (see
  // `.halftone-spotlight` in the global styles below). Position
  // tracking is trivial here: the element is `position: fixed;
  // inset: 0`, so its own box IS the viewport, meaning the cursor's
  // `clientX`/`clientY` are already exactly the right coordinates —
  // no per-section bounding-rect math needed. Whether the spotlight is
  // actually visible is handled separately, in pure CSS, via
  // `body:has(.halftone-hover:hover) .halftone-spotlight` — this
  // script only ever needs to know where the cursor is, never which
  // section it's over.
  const spotlight = document.querySelector<HTMLElement>(".halftone-spotlight");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (spotlight && !prefersReducedMotion) {
    window.addEventListener("mousemove", (e) => {
      spotlight.style.setProperty("--mx", `${e.clientX}px`);
      spotlight.style.setProperty("--my", `${e.clientY}px`);
    });
  }
</script>

<style is:global>
  :root {
    color-scheme: light;

    /* Shared boundary colors for the page-wide sky -> sunset -> dusk
       backdrop across the whole `.sky-chain` run. Each section's
       gradient reuses the SAME variable at a shared edge, so adjacent
       sections are guaranteed to meet at the exact same color — not
       just a close visual match — with zero risk of the two ever
       drifting apart the way hand-picked hex values in two different
       files could.

       Current page order (after you moved EducationIslandSection to
       sit right after IntroIslandSection, ahead of Art/Computer) is:
       Intro -> Education -> Art -> Computer -> Achievement -> Bonus ->
       Other. The variable NAMES below still reflect the ORIGINAL order
       they were introduced in (e.g. `--sky-2` was first picked to
       match Computer/Education, back when that was their pairing) —
       reordering the sections didn't rename these, it just changed
       WHICH pair of `--seam-target-top`/`--seam-target-bottom`
       declarations (in each section's own file) reference which
       variable, same way you'd move furniture around a room without
       repainting it. See each section's own top-of-file comment for
       which variable it currently uses on which edge — that's the
       up-to-date source of truth for the CURRENT chain order; the
       list below just documents what each variable's color value is
       and where it originally came from.

       --dusk-blue is AchievementIslandSection's bottom color, which
       matches BonusIslandSection's top (BonusIslandSection sits
       between Achievement and the closing OtherIslandSection). This
       used to be an eyeballed guess off a screenshot; once you
       uploaded the actual bonus_island_background.png, it was updated
       to the real sampled top-row color of that image (#0cd4ee)
       instead. */
    --sky-0: #dcf3fc; /* unused placeholder from before IntroIslandSection existed — kept only so removing it doesn't need to be a separate cleanup pass */
    --sky-1: #3a6ef5; /* Art bottom / Computer top seam-blend target — set to rgb(58, 110, 245) per your request; this pairing is unchanged by the reorder */
    --sky-2: #0ADEFB; /* Computer bottom / Achievement top seam-blend target — updated to rgb(10, 222, 251) per your request (previously #14e5fb). Originally Computer bottom / Education top, reassigned to Computer bottom / Achievement top now that Education no longer sits between them */
    --sky-3: #00CDF2; /* Education bottom / Art top seam-blend target — set to rgb(29, 237, 250) per your request; originally Education bottom / Achievement top, reassigned to Education bottom / Art top now that Art sits right after Education instead */
    --dusk-blue: #00d4f4; /* Achievement bottom / Bonus top seam-blend target — set to rgb(0, 212, 244) per your request; this pairing is unchanged by the reorder */
    --sky-4: #04c9d1; /* Bonus bottom / Other top seam-blend target — set to rgb(4, 201, 209) per your request; this pairing is unchanged by the reorder */

    /* Now IntroIslandSection bottom / EducationIslandSection top
       seam-blend target — originally Intro bottom / Art top, back
       when Art was the section directly after Intro. Reassigned to
       Intro bottom / Education top now that Education sits there
       instead. Set to rgb(0, 221, 249) per your request. Named
       descriptively rather than continuing the `--sky-N` numbering,
       same reasoning as `--dusk-blue`: it sits outside that sequential
       run rather than as its next member. */
    --intro-seam: #00DDF9;

    /* --sunset-mid / --sunset-deep are no longer used — they backed
       AchievementIslandSection's old 4-stop gradient, which is now a
       real background image like the rest of the chain. Left out
       entirely rather than kept as dead variables. */
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    /* Page-level horizontal-scroll guard. This used to live as
       `overflow: hidden` on each individual flanking-island section
       (Art/Computer/Education/Achievement), clipping their
       intentionally edge-bleeding islands. That worked for the
       horizontal bleed it was meant for, but also clipped those
       islands VERTICALLY whenever one needed more room than its own
       section's box provided — the "islands cut off at the top/bottom"
       bug. Moving the horizontal clip up here means the individual
       sections no longer need `overflow: hidden` at all: horizontal
       bleed off the viewport's left/right edges is still caught here,
       but an island that overflows past its own section's top/bottom
       is now free to do so instead of being hard-clipped.
       `overflow-x: hidden` alone left a sliver of white space visible
       on some mobile screens — one of the intentionally bleeding
       islands (Art's corners, Education's stack, CornerIsland, etc.)
       was pushing the page's actual scrollable width past the visible
       viewport, and `hidden` on `html` by itself doesn't always fully
       suppress that on every mobile browser. `overflow-x: clip` is a
       stricter mode that also removes the overflow from the
       scrollable area entirely (rather than just hiding a scrollbar),
       so it's added as a second line — browsers that don't support
       `clip` yet just keep using the `hidden` line above it, and ones
       that do support it get the stronger guarantee. `width: 100%`
       plus `max-width: 100vw` on `body` below closes the gap the rest
       of the way, so no descendant can widen the actual html/body box
       in the first place. */
    overflow-x: hidden;
    overflow-x: clip;
  }

  body {
    margin: 0;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    font-family: ui-sans-serif, system-ui, sans-serif;
    background: #ffffff;
    color: #1a1a1a;
    line-height: 1.5;
  }

  /* Breathing room between sections. Every section component in this
     project (Section.astro, ArtIslandSection.astro,
     ComputerIslandSection.astro, EducationIslandSection.astro,
     AchievementIslandSection.astro, ...) renders a top-level
     `<section>`, and they're all siblings directly under `<body>` via
     `<slot />` here — so one adjacent-sibling rule here adds the gap
     between every pair of them, instead of having to repeat a
     margin/padding rule inside each section component individually.
     `section + section` only matches from the second section onward,
     so the very first section on the page stays flush with the top.
     If a section ever needs to sit flush against its neighbor on
     purpose, override with `margin-top: 0` on that specific instance
     (e.g. via a wrapper class) rather than removing this rule. */
  section + section {
    margin-top: clamp(2rem, 6vw, 5rem);
  }

  /* The 4 gradient-backed sections (ArtIslandSection,
     ComputerIslandSection, EducationIslandSection,
     AchievementIslandSection), plus BonusIslandSection and
     OtherIslandSection (both backed by real images instead of a CSS
     gradient, but part of the same continuous chain visually), all
     carry this marker class specifically so this override can zero
     out the gap rule above between them. A visible white strip from
     the rule above would show through right at each seam and break
     the continuous-sky illusion, so consecutive `.sky-chain` sections
     sit flush against each other; the gap rule still applies normally
     around any section that ISN'T part of the chain.
     IntroIslandSection now also carries `.sky-chain` (it's the first
     section in the chain, ahead of ArtIslandSection), so this rule is
     what makes those two sit flush together too. */
  .sky-chain + .sky-chain {
    margin-top: 0;
  }

  /* Seam-blend utility classes, shared across every section in the
     `.sky-chain`. Each `cover`-cropped section can only guarantee its
     OWN edge pixel is exact on ONE of its two sides (top OR bottom,
     whichever `background-position` protects) — the other side is an
     arbitrary crop of interior content, and even on a "both sides
     protected" seam, the two different source images' true edge
     colors aren't guaranteed to match each other. Rather than trying
     to fix that at the image-crop level (which `cover` fundamentally
     can't do for more than one edge per section), these two classes
     repaint a soft gradient band at the very top/bottom of a section,
     fading between the section's own actual image and a flat,
     agreed-upon color — so regardless of what the underlying cropped
     image actually shows right at the boundary, the seam eases into
     the same color on both sides instead of hitting a hard line.
     (Tried a wave-shaped cutout here first — reverted per your
     feedback back to a plain top-to-bottom gradient blend.)

     `.seam-fade-bottom::after` paints a band at the very bottom of a
     section, fading from transparent (revealing the section's own
     image, in the middle) to solid `--seam-target-bottom` (right at
     the bottom edge). `.seam-fade-top::before` paints a matching band
     at the very TOP of the next section, fading from solid
     `--seam-target-top` (right at the top edge) back to transparent.
     On a properly paired seam both variables are set to the identical
     color, so the two fades reach the same color exactly where the
     sections meet — no hard line, just a smooth color blend on both
     sides of the seam.

     A section that needs fades on BOTH sides (e.g. ComputerIslandSection,
     ArtIslandSection now that IntroIslandSection precedes it, ...
     sandwiched between two different seams) carries both classes and
     sets both `--seam-target-*` variables independently — they don't
     have to be the same color. `height` uses `clamp()` so the band
     stays a sensible size on both very short and very tall viewports.
     `z-index: 0` keeps this below normal in-flow content (`.content`,
     islands — all z-index 1+), and `pointer-events: none` keeps it
     from blocking anything. */
  .seam-fade-bottom,
  .seam-fade-top {
    position: relative;
  }

  .seam-fade-bottom::after,
  .seam-fade-top::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: clamp(40px, 9vh, 140px);
    z-index: 0;
    pointer-events: none;
  }

  .seam-fade-bottom::after {
    bottom: 0;
    background: linear-gradient(to bottom, transparent, var(--seam-target-bottom));
  }

  .seam-fade-top::before {
    top: 0;
    background: linear-gradient(to bottom, var(--seam-target-top), transparent);
  }

  /* Halftone cursor spotlight — a dot-grid pattern that shows around
     the cursor while it's over any `.halftone-hover` section,
     print-halftone style (inspired by the card hover effect on
     rossdraws.com/collections/tutorials).

     ONE element for the whole page (added once in the `<body>` above,
     not per-section) — this replaces an earlier per-section design
     that sized `.halftone-overlay` to each section and let it bleed
     `--halftone-radius` past that section's own edges so the circle
     wouldn't get clipped mid-shape near a boundary. That worked at
     internal seams (the next section painted over the bleed) but
     broke in two ways: the very last section's downward bleed had
     nothing to paint over it, quietly adding blank scrollable space
     to the bottom of the page; and OtherIslandSection sets its own
     `overflow-x: hidden` for its full-viewport-width breakout, which
     (per the CSS overflow spec: setting one overflow axis to non-
     visible computes the other to `auto` if it was `visible`) made
     ITS OWN `overflow-y` compute to `auto` — so unlike every other
     section, it actually clipped its own overlay's upward bleed at
     its own top edge, cutting the circle off right where it meets
     BonusIslandSection.

     This version sidesteps both bugs instead of patching around them:
     `position: fixed; inset: 0` means the element IS the viewport, not
     sized to or bounded by any section, so there's no section
     boundary left to bleed past or get clipped by, and being `fixed`
     it's out of normal flow entirely — it can never add to the page's
     scrollable height regardless of how big its mask circle is.
     `--mx`/`--my` are plain viewport coordinates, kept in sync with
     the cursor by the single script in this file (no per-section
     bounding-rect math needed any more either, since this element's
     box always starts at (0, 0) in viewport space). `mix-blend-mode:
     overlay` still blends the dots against whatever section happens
     to be underneath at that screen position — that part didn't need
     to change, blend modes don't care whether the element above is
     sized to a section or the whole viewport.

     Visibility is handled in pure CSS via `:has()` rather than a
     per-section `:hover` rule targeting a per-section child: `body:
     has(.halftone-hover:hover) .halftone-spotlight` sets opacity only
     while the cursor is over SOME `.halftone-hover` section, whichever
     one it currently is — the single spotlight element doesn't need
     to know which.

     `z-index: 0` (not something high like 9999) is deliberate: every
     island/illustration in this family (`.art-island`, `.computer-
     island`, `.education-island-*`, `.achievement-island`, and
     CornerIsland.astro's own front island) is `z-index: 1` or higher,
     and `.content` is `z-index: 2`/`3` — while each section's own
     `background-image` and the `.seam-fade-*` gradients sit at
     `z-index: 0`/auto, the same tier as this element. Since this
     `<div>` is the LAST element in the document (added after every
     section and after `<CornerIsland />`), it paints AFTER everything
     else at that z-index-0 tier — i.e. visually on top of every
     section's background and every seam-fade gradient, which is what
     lets `mix-blend-mode: overlay` actually tint them — but still
     BELOW every island and every `.content` block, which have a
     strictly higher z-index and so paint after (on top of) this
     element regardless of DOM order. Blend modes only affect what's
     already painted BEHIND an element, never what paints after it, so
     the net effect is: halftone shows on backgrounds and seam fades,
     and islands/text render normally on top, untouched. If some
     future island or foreground decoration on the page ever omits an
     explicit `z-index` (leaving it at the default `auto`, tying with
     this element), it would need one added to stay excluded — same
     requirement every other island in this family already follows. */
  .halftone-spotlight {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
    --halftone-color: #ffffff;
    --halftone-radius: 160px;
    --mx: 50vw;
    --my: 50vh;
    background-image: radial-gradient(circle, var(--halftone-color) 38%, transparent 40%);
    background-size: 10px 10px;
    mix-blend-mode: overlay;
    mask-image: radial-gradient(circle var(--halftone-radius) at var(--mx) var(--my), black 0%, black 55%, transparent 100%);
    -webkit-mask-image: radial-gradient(circle var(--halftone-radius) at var(--mx) var(--my), black 0%, black 55%, transparent 100%);
  }

  body:has(.halftone-hover:hover) .halftone-spotlight {
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .halftone-spotlight {
      transition: none;
    }
  }
</style>