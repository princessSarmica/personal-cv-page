---
// src/components/BonusIslandSection.astro
//
// Last content section on the page, sitting between
// AchievementIslandSection and the purely decorative closing
// OtherIslandSection. Unlike the rest of the flanking-islands family,
// this one has no separate island illustrations or mouse-repel script
// — just centered text over a single full-bleed background image
// (`backgroundImage`, your bonus_island_background.webp).
//
// Background: real image (`backgroundImage`), via `background-image`
// + `background-size: cover`, `min-height: 100vh` — brought in line
// with the rest of the family (this section used to be the odd one
// out, on a real, uncropped <img> instead). The goal across every
// section in this chain is a CONSISTENT height on every screen size,
// with the background's left/right edges cropped as needed to make
// that happen, rather than letting each image's own aspect ratio
// drive its section's height.
//
// `background-position: top` protects this section's TOP edge — the
// one that has to match AchievementIslandSection's bottom. The bottom
// edge (against OtherIslandSection, the closing full-bleed
// illustration) is the lower-priority side — OtherIslandSection shows
// its own image at full aspect ratio on desktop regardless, so that
// seam was always more approximate than pixel-locked.
//
// I sampled the actual pixel colors of both images you'd uploaded
// earlier (before this section moved off the real-<img> approach)
// rather than eyeballing them off screenshots:
//   bonus_island_background.png  top ~ #0cd4ee, bottom ~ #04c9d1
//   other_island_2.webp          top ~ #08c6c9
// `--dusk-blue` in Layout.astro (AchievementIslandSection's bottom,
// which this section's top needs to match) is still set to that
// sampled #0cd4ee.
//
// Carries `seam-fade-top` (blending into var(--dusk-blue)) to pair
// with AchievementIslandSection's `seam-fade-bottom` — since
// Achievement's bottom edge turned out to be an arbitrary/uncropped
// crop rather than a fixed color (confirmed by sampling multiple
// screenshots of the same seam), this fade is what actually makes the
// two sides agree on a color, rather than relying on the underlying
// images to happen to match.
//
// Also carries `seam-fade-bottom` (blending into var(--sky-4)) to pair
// with OtherIslandSection's `seam-fade-top` — same idea, softening the
// boundary against the closing illustration.
//
// This section (and OtherIslandSection) carry the shared `.sky-chain`
// marker class from Layout.astro, so the normal gap between sections
// collapses to 0 on both sides of this one — see the
// `.sky-chain + .sky-chain` rule there.
//
// Usage:
//   <BonusIslandSection
//     id="section-bonus"
//     eyebrow="Bonus"
//     title="One More Thing"
//     text="..."
//     backgroundImage="/images/bonus_island_background.webp"
//   />

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  text: string;
  backgroundImage: string;
}

const { id, eyebrow, title, text, backgroundImage } = Astro.props;
---

<section
  class="bonus-section sky-chain seam-fade-top seam-fade-bottom"
  id={id}
  style={`background-image: url(${backgroundImage});`}
>
  <div class="content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p class="body-text">{text}</p>
  </div>
</section>

<style>
  .bonus-section {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 6vw, 6rem);
    /* No `overflow: hidden` here — see the comment on `overflow-x:
       hidden` on `html` in Layout.astro. */
    background-size: cover;
    background-position: top;
    background-repeat: no-repeat;
    /* Seam-blend targets (see the shared comment in Layout.astro) —
       one variable per edge since this section needs two different
       colors. Top softens into var(--dusk-blue)
       (AchievementIslandSection's bottom); bottom softens into
       var(--sky-4) (OtherIslandSection's top). */
    --seam-target-top: var(--dusk-blue);
    --seam-target-bottom: var(--sky-4);
  }

  .content {
    position: relative;
    z-index: 2;

    width: min(32ch, 100%);
    margin: 0 auto;

    text-align: left;
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555;
    margin: 0 0 0.75rem;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    margin: 0 0 1rem;
    color: #1a1a1a;
  }

  .body-text {
    font-size: 1.05rem;
    color: #444;
    margin: 0;
  }

  @media (max-width: 640px) {
    .content {
      width: min(32ch, 100%);
      padding-inline: 1.5rem;
    }
  }
</style>