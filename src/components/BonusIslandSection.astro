---
// src/components/BonusIslandSection.astro
//
// Last content section on the page, sitting between
// AchievementIslandSection and the purely decorative closing
// OtherIslandSection. Unlike the rest of the flanking-islands family,
// this one has no separate island illustrations — just centered text
// over a single full-bleed background image (`backgroundImage`, your
// bonus_island_background.webp).
//
// Background: real image (`backgroundImage`), via `background-image`
// + `background-size: cover`, `min-height` — brought in line with the
// rest of the family (this section used to be the odd one out, on a
// real, uncropped <img> instead). The goal across every section in
// this chain is a CONSISTENT height on every screen size (now 130vh,
// see the comment on `.bonus-section` below), with `cover` cropping
// whichever dimension needs it least to make that happen with no gaps.
// Briefly tried sizing by height only (`auto 100%`, cropping only the
// sides) per your request to stop shortening backgrounds vertically on
// wide screens, but that left visible white space on screens wider (in
// aspect ratio) than the image itself, which you didn't want either —
// back to `cover`.
//
// One more layer on top of that: on a short/wide viewport, `cover`
// still has to crop SOMETHING to avoid a gap, and per your follow-up
// that "something" shouldn't ever be the image's own height either —
// you'd rather scroll than see it shortened. Fixed by adding
// `aspect-ratio: 16 / 9` (the image's real ratio) alongside
// `min-height`/`width: 100%` on `.bonus-section` below, so the section
// itself grows taller than 130vh on those viewports instead of asking
// `cover` to crop into the height — see the comment there.
//
// No seam-fade classes any more — the shared fade-band system that
// used to blend section edges together was removed per your request,
// so this section now just butts directly against AchievementIslandSection
// above it and OtherIslandSection below it.
//
// This section (and OtherIslandSection) carry the shared `.sky-chain`
// marker class from Layout.astro, so the normal gap between sections
// collapses to 0 on both sides of this one — see the
// `.sky-chain + .sky-chain` rule there.
//
// Now also carries `.halftone-hover`, joining the single, page-wide
// cursor-spotlight element in Layout.astro (`.halftone-spotlight`,
// see the comment there) purely by carrying this class — no markup or
// script needed here for it, since `body:has(.halftone-hover:hover)
// .halftone-spotlight` is what actually turns the spotlight on. This
// component still has no `<script>` tag of its own — nothing here
// needs the mouse-repel parallax drift either, since there are no
// islands.
//
// Usage:
//   <BonusIslandSection
//     id="section-bonus"
//     eyebrow="Bonus"
//     title="One More Thing"
//     text="..."
//     backgroundImage="/images/bonus_island_background.webp"
//   />

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  text: string;
  backgroundImage: string;
}

const { id, eyebrow, title, text, backgroundImage } = Astro.props;
---

<section
  class="bonus-section sky-chain halftone-hover"
  id={id}
  style={`background-image: url(${backgroundImage});`}
>
  <div class="content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p class="body-text">{text}</p>
  </div>
</section>

<style>
  .bonus-section {
    position: relative;
    /* Bumped up from 100vh to give the section more scroll room (e.g.
       so CornerIsland.astro's freeze point, which lands partway down
       this section via FREEZE_TARGET_FRACTION, has more page to sit
       within before OtherIslandSection starts). Adjust this value
       directly if you want the section taller/shorter still. */
    min-height: 130vh;
    /* `aspect-ratio: 16 / 9` matches the background image (measured at
       3840x2160) — combined with `width: 100%` and `min-height`, the
       browser uses whichever constraint needs MORE height: on a
       viewport wider-than-16:9 (mainly short/wide windows), the
       aspect-ratio wins and this section grows taller than 130vh,
       showing the FULL image at its native ratio with no cropping —
       you scroll to see the rest, per your request, instead of
       `cover` shortening (cropping) the image's height to fit a
       too-short viewport. On a taller-than-16:9 viewport (e.g. mobile
       portrait), `min-height: 130vh` wins instead, so the section
       stays exactly 130vh tall and `cover` crops the sides only —
       unchanged from before. `width: 100%` is required alongside
       `aspect-ratio` — without it, on the min-height-wins branch the
       browser would stretch this section's WIDTH to satisfy the ratio
       instead of its height, overflowing past the viewport edges. */
    width: 100%;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 6vw, 6rem);
    /* No `overflow: hidden` here — see the comment on `overflow-x:
       hidden` on `html` in Layout.astro. */
    /* `cover` — always fills the section edge-to-edge with no gaps,
       cropping whichever dimension needs it least (see the top-of-file
       comment for why this isn't sized by height alone). */
    background-size: cover;
    background-position: top;
    background-repeat: no-repeat;
  }

  .content {
    position: relative;
    z-index: 2;

    width: min(32ch, 100%);
    margin: 0 auto;

    text-align: left;
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555;
    margin: 0 0 0.75rem;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    margin: 0 0 1rem;
    color: #1a1a1a;
  }

  .body-text {
    font-size: 1.05rem;
    color: #444;
    margin: 0;
  }

  @media (max-width: 640px) {
    .content {
      width: min(32ch, 100%);
      padding-inline: 1.5rem;
    }
  }
</style>