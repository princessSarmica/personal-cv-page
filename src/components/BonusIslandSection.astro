---
// src/components/BonusIslandSection.astro
//
// Last content section on the page, sitting between
// AchievementIslandSection and the purely decorative closing
// OtherIslandSection. Unlike the rest of the flanking-islands family,
// this one has no separate island illustrations or mouse-repel script
// — just centered text over a single full-bleed background image
// (`backgroundImage`, your bonus_island_background.webp).
//
// I sampled the actual pixel colors of both images you've uploaded
// rather than eyeballing them off screenshots:
//   bonus_island_background.png  top ~ #0cd4ee, bottom ~ #04c9d1
//   other_island_2.webp          top ~ #08c6c9
// Two things follow from that:
//   1. AchievementIslandSection's `--dusk-blue` variable (its own
//      bottom color, which this section's TOP needs to match) has
//      been updated in Layout.astro from an eyeballed guess to the
//      real sampled #0cd4ee, so that seam is now an exact match
//      instead of a close-enough one.
//   2. This section's bottom (~#04c9d1) and other_island_2's top
//      (~#08c6c9) are close but not pixel-identical — a few points
//      off in each RGB channel. That's normal (compression, and I
//      averaged a strip rather than the exact edge row), and since
//      both images are a fairly uniform, smooth sky/teal color right
//      at that edge (not detailed illustration content), the
//      difference should read as invisible in practice. If you or I
//      spot an actual visible line once it's live, the fix is a
//      matching CSS gradient overlay at the seam rather than
//      re-exporting the art.
//
// Background sizing: `background-size: cover` so the image always
// fills the section at any viewport size, but `background-position:
// bottom` specifically (not `center`) — that guarantees the true
// bottom edge (the one matching other_island_2's top) is NEVER what
// gets cropped away on an odd aspect ratio; only the top edge can lose
// a sliver, and that seam is against a CSS gradient variable I can
// freely retune to match whatever ends up showing, so it's the safer
// side to leave flexible.
//
// This section (and OtherIslandSection) carry the shared `.sky-chain`
// marker class from Layout.astro, so the normal gap between sections
// collapses to 0 on both sides of this one — see the
// `.sky-chain + .sky-chain` rule there.
//
// Usage:
//   <BonusIslandSection
//     id="section-bonus"
//     eyebrow="Bonus"
//     title="One More Thing"
//     text="..."
//     backgroundImage="/images/bonus_island_background.webp"
//   />

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  text: string;
  backgroundImage: string;
}

const { id, eyebrow, title, text, backgroundImage } = Astro.props;
---

<section
  class="bonus-section sky-chain"
  id={id}
  style={`background-image: url(${backgroundImage});`}
>
  <div class="content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p class="body-text">{text}</p>
  </div>
</section>

<style>
  .bonus-section {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 6vw, 6rem);
    overflow: hidden;
    background-size: cover;
    background-position: bottom;
    background-repeat: no-repeat;
  }

  .content {
    position: relative;
    z-index: 2;

    width: min(32ch, 100%);
    margin: 0 auto;

    text-align: left;
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555;
    margin: 0 0 0.75rem;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    margin: 0 0 1rem;
    color: #1a1a1a;
  }

  .body-text {
    font-size: 1.05rem;
    color: #444;
    margin: 0;
  }

  @media (max-width: 640px) {
    .content {
      width: min(32ch, 100%);
      padding-inline: 1.5rem;
    }
  }
</style>