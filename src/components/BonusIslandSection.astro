---
// src/components/BonusIslandSection.astro
//
// Last content section on the page, sitting between
// AchievementIslandSection and the purely decorative closing
// OtherIslandSection. Unlike the rest of the flanking-islands family,
// this one has no separate island illustrations — just centered text
// over a single full-bleed background image (`backgroundImage`, your
// bonus_island_background.webp).
//
// Background: real image (`backgroundImage`), via `background-image`
// + `background-size: cover`, `min-height` — brought in line with the
// rest of the family (this section used to be the odd one out, on a
// real, uncropped <img> instead). The goal across every section in
// this chain is a CONSISTENT height on every screen size (now 130vh,
// see the comment on `.bonus-section` below), with `cover` cropping
// whichever dimension needs it least to make that happen with no gaps.
// Briefly tried sizing by height only (`auto 100%`, cropping only the
// sides) per your request to stop shortening backgrounds vertically on
// wide screens, but that left visible white space on screens wider (in
// aspect ratio) than the image itself, which you didn't want either —
// back to `cover`.
//
// One more layer on top of that: on a short/wide viewport, `cover`
// still has to crop SOMETHING to avoid a gap, and per your follow-up
// that "something" shouldn't ever be the image's own height either —
// you'd rather scroll than see it shortened. Fixed by adding
// `aspect-ratio: 16 / 9` (the image's real ratio) alongside
// `min-height`/`width: 100%` on `.bonus-section` below, so the section
// itself grows taller than 130vh on those viewports instead of asking
// `cover` to crop into the height — see the comment there.
//
// No seam-fade classes any more — the shared fade-band system that
// used to blend section edges together was removed per your request,
// so this section now just butts directly against AchievementIslandSection
// above it and OtherIslandSection below it.
//
// This section (and OtherIslandSection) carry the shared `.sky-chain`
// marker class from Layout.astro, so the normal gap between sections
// collapses to 0 on both sides of this one — see the
// `.sky-chain + .sky-chain` rule there.
//
// Now also carries `.halftone-hover`, joining the single, page-wide
// cursor-spotlight element in Layout.astro (`.halftone-spotlight`,
// see the comment there) purely by carrying this class — no markup or
// script needed here for it, since `body:has(.halftone-hover:hover)
// .halftone-spotlight` is what actually turns the spotlight on. This
// component still has no `<script>` tag of its own — nothing here
// needs the mouse-repel parallax drift either, since there are no
// islands.
//
// Clouds background (`cloudsBackground`, your bonus_island_background_
// clouds.webp): same looping two-tile technique as every other clouds
// layer in this project (ArtIslandSection's `.art-clouds-bg`,
// ComputerIslandSection's `.computer-clouds-bg`,
// AchievementIslandSection's `.achievement-clouds-bg`, etc. — see any
// of those files' comments for the full mechanics: two pixel-identical
// `<img>` tiles, sized `height: 100%; width: auto` inside a
// `width: max-content` track, `translateX` animated from `-50%` to
// `0%` for a seamless infinite drift). Measured this texture's own
// left/right edge match before wiring it up (same check used for
// every other clouds asset here): ~3.4-3.6 average per-channel edge
// difference — softer than Achievement's ~0.92 but still a soft,
// blurry cloud texture rather than a hard-edged one, so a faint seam
// is unlikely to read as a hard line; flag it if a visible seam shows
// up in practice and it can be reprocessed like some of the earlier
// clouds assets in this project were.
// UNLIKE every other section's clouds layer, this one sits IN FRONT
// of the main artwork, not behind it — `backgroundImage` here
// (bonus_island_background.webp) is a single fully-opaque photo with
// no transparent regions (confirmed: no alpha channel at all), unlike
// e.g. Achievement's ruins image, so there is no gap for a layer
// behind it to show through. `.bonus-clouds-bg` sits between the
// section's own `background-image` (which always paints at the
// section's own furthest-back layer, regardless of z-index — same
// reasoning used throughout this project) and `.content`, blended
// into the scene with `mix-blend-mode: lighten` + reduced `opacity`
// (see that rule's own comment) rather than layered flat on top, so
// it reads as atmospheric drifting cloud cover instead of a hard
// rectangle pasted over the artwork.
//
// Usage:
//   <BonusIslandSection
//     id="section-bonus"
//     eyebrow="Bonus"
//     title="One More Thing"
//     text="..."
//     backgroundImage="/images/bonus_island_background.webp"
//     cloudsBackground="/images/bonus_island_background_clouds.webp"
//   />

// New: `backgroundImage`/`cloudsBackground` are imported src/images/
// modules (`ImageMetadata`) instead of public/images/ URL strings —
// see src/pages/index.astro's frontmatter note for why.
// `cloudsBackground`'s two tiles render via <Image />; `backgroundImage`
// paints as this section's own CSS `background-image`, which <Image />
// (an element, not a URL) can't do, so `getImage()` — the same
// astro:assets pipeline underneath <Image /> — runs it through
// Astro's optimizer at build time for the `url(...)` below.
import { Image } from 'astro:assets';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  text: string;
  backgroundImage: ImageMetadata;
  cloudsBackground: ImageMetadata;
}

const { id, eyebrow, title, text, backgroundImage, cloudsBackground } = Astro.props;
const optimizedBackgroundImage = await getImage({ src: backgroundImage });
---

<section
  class="bonus-section sky-chain halftone-hover"
  id={id}
  style={`background-image: url(${optimizedBackgroundImage.src});`}
>
  <div class="bonus-clouds-bg" aria-hidden="true">
    <div class="bonus-clouds-track">
      <Image class="bonus-clouds-tile" src={cloudsBackground} alt="" />
      <Image class="bonus-clouds-tile" src={cloudsBackground} alt="" />
    </div>
  </div>

  <div class="content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {/* set:html here because this text is a real HTML bullet list
       (see src/i18n/ui.ts) -- <div>, not <p>, since a <ul> can't nest
       inside a <p>. */}
    <div class="body-text" set:html={text} />
  </div>
</section>

<style>
  .bonus-section {
    position: relative;
    /* Bumped up from 100vh to give the section more scroll room (e.g.
       so CornerIsland.astro's freeze point, which lands partway down
       this section via FREEZE_TARGET_FRACTION, has more page to sit
       within before OtherIslandSection starts). Adjust this value
       directly if you want the section taller/shorter still. */
    min-height: 130vh;
    /* `aspect-ratio: 16 / 9` matches the background image (measured at
       3840x2160) — combined with `width: 100%` and `min-height`, the
       browser uses whichever constraint needs MORE height: on a
       viewport wider-than-16:9 (mainly short/wide windows), the
       aspect-ratio wins and this section grows taller than 130vh,
       showing the FULL image at its native ratio with no cropping —
       you scroll to see the rest, per your request, instead of
       `cover` shortening (cropping) the image's height to fit a
       too-short viewport. On a taller-than-16:9 viewport (e.g. mobile
       portrait), `min-height: 130vh` wins instead, so the section
       stays exactly 130vh tall and `cover` crops the sides only —
       unchanged from before. `width: 100%` is required alongside
       `aspect-ratio` — without it, on the min-height-wins branch the
       browser would stretch this section's WIDTH to satisfy the ratio
       instead of its height, overflowing past the viewport edges. */
    width: 100%;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 6vw, 6rem);
    /* No `overflow: hidden` here — see the comment on `overflow-x:
       hidden` on `html` in Layout.astro. */
    /* `cover` — always fills the section edge-to-edge with no gaps,
       cropping whichever dimension needs it least (see the top-of-file
       comment for why this isn't sized by height alone). */
    background-size: cover;
    background-position: top;
    background-repeat: no-repeat;
  }

  /* Looping clouds layer — now the MAIN background for this section
     (see the top-of-file "Clouds background" comment for the original
     blended-overlay version, and the paragraph below for why it's
     fully opaque now instead). `inset: 0` (no top/bottom shift like
     Achievement's — this layer doesn't need to reach a specific point
     behind other artwork, it just covers the section) plus
     `overflow: hidden` clips the horizontally-drifting track back
     down to the section's own box.
     New: per your request to see how it looks with the clouds as the
     MAIN background instead of a blended overlay — `mix-blend-mode`
     removed and `opacity` set to `1`. Since this layer already
     covers the section edge-to-edge (`inset: 0`) and sits in FRONT of
     `background-image` in paint order, a fully opaque top layer with
     no blending completely hides that image now rather than meshing
     with it — `backgroundImage` (and its CSS below) is left wired up
     untouched, just fully covered up, so reverting this experiment is
     a two-line change: put `mix-blend-mode: lighten;` and
     `opacity: 0.8;` back (see the git history in this comment, or
     just ask).
     New: `z-index` dropped from `1` to `0`, per your report that
     HobbyIslandSection's islands (the section directly above this
     one) were getting cut off. Same recurring stacking-context bug
     as elsewhere in this project (see ComputerIslandSection.astro's
     comments for the fullest writeup of the mechanism): neither
     `.hobby-section` nor `.bonus-section` sets its own z-index, so
     neither traps its children into one stacking unit — HobbyIsland-
     Section's `.hobby-island-group` (its front group deliberately
     bleeds below Hobby's own bottom edge into this section, at
     `z-index: 1` — see that file's own comment on `.hobby-island-
     group`) was competing DIRECTLY against this layer in their shared
     overlap zone instead of losing to "Hobby" as one unit. Both were
     tied at `z-index: 1`, and a tie breaks by DOM order — this
     section comes AFTER Hobby in the page, so this (fully opaque,
     covering the whole section edge-to-edge) layer was winning that
     tie and painting straight over the bottom of Hobby's bleeding
     islands, which is exactly what read as "cut off." `z-index: 0`
     now loses outright to Hobby's `z-index: 1` in that overlap zone,
     letting the islands render fully in front. This layer still beats
     `background-image` underneath it (a plain `background-image`
     always paints at its own element's furthest-back layer regardless
     of z-index, same reasoning used throughout this project) and
     still loses to `.content` (`z-index: 2`) locally, so nothing else
     changes. */
  .bonus-clouds-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bonus-clouds-track {
    display: flex;
    /* Keeps the two tile images from being flex-stretched vertically
       — same reasoning as every other clouds track in this project. */
    align-items: flex-start;
    width: max-content;
    height: 100%;
    animation: bonus-clouds-drift 90s linear infinite;
  }

  .bonus-clouds-tile {
    display: block;
    height: 100%;
    width: auto;
    max-width: none;
    flex-shrink: 0;
    /* New: explicit `aspect-ratio` (cloudsBackground's own real size)
       — <Image /> defaults to `loading="lazy"`, and Chrome flags a
       lazy image whose box isn't pinned by fixed width+height or a
       declared `aspect-ratio`; `height: 100%; width: auto;` alone
       doesn't count, so this states the real ratio directly. */
    aspect-ratio: 7680 / 2160;
  }

  @keyframes bonus-clouds-drift {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bonus-clouds-track {
      animation: none;
    }
  }

  .content {
    position: relative;
    z-index: 2;

    width: min(32ch, 100%);
    margin: 0 auto;

    text-align: left;
  }

  /* Wider text column on big screens, per request. */
  @media (min-width: 1100px) {
    .content {
      width: min(50ch, 100%);
    }
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555;
    margin: 0 0 0.75rem;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    margin: 0 0 1rem;
    color: #1a1a1a;
  }

  .body-text {
    font-size: 1.05rem;
    color: #444;
    margin: 0;
  }

  .body-text ul {
    margin: 0;
    padding-left: 0;
    list-style: disc;
  }

  .body-text li {
    margin: 0 0 0.5rem;
  }

  .body-text li:last-child {
    margin-bottom: 0;
  }

  .body-text a {
    color: #1a1a1a;
    text-decoration: underline;
    text-decoration-color: #999;
    text-underline-offset: 0.15em;
    transition: text-decoration-color 0.2s ease;
  }

  .body-text a:hover {
    text-decoration-color: #1a1a1a;
  }

  @media (max-width: 640px) {
    .content {
      width: min(32ch, 100%);
      padding-inline: 1.5rem;
    }
  }
</style>