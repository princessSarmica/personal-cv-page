---
// src/components/CornerIsland.astro
//
// The persistent "front" island — stays fixed in the bottom-left corner
// across every section as the page scrolls, up through the first half
// of BonusIslandSection (id="section-bonus" in src/pages/index.astro;
// see FREEZE_TARGET_FRACTION / FREEZE_BUFFER_PX in the script below to
// move that stop point). Once it reaches that point it stops tracking
// the viewport and is left behind at that page position instead, so it
// scrolls away normally like any other page content rather than
// continuing to hover in front of the rest of Bonus and
// OtherIslandSection (id="section-closing"), the very last section.
// This is separate from the per-section illustrations in Section.astro,
// which come and go with each section.
//
// Two images live stacked on top of each other inside
// `.corner-island-inner`:
//   - front-island.svg               (default, shown everywhere)
//   - front_island_cartoon_version.webp  (shown only while the user is
//     over HobbyIslandSection, id="section-hobbies")
// One IntersectionObserver (bottom of this file) watches that section
// and toggles the `.is-hobby` class on `.corner-island`, which
// crossfades between the two via opacity transitions. Swap either
// image file in public/images/ with the same filename to update the
// art later; nothing else needs to change.
//
// A second, independent piece of script further down handles the
// "stop partway through BonusIslandSection" behavior described above:
// it measures a point partway down `#section-bonus` (its vertical
// middle by default) and, once you've scrolled that far, swaps
// `.corner-island` from `position: fixed` to `position: absolute` at
// that exact document position via the `.is-frozen` class +
// `--frozen-top` custom property. Scrolling back up past that point
// reverts it to `position: fixed` again, so the behavior works
// smoothly in both scroll directions.
//
// Three nested layers on purpose:
//   .corner-island        — fixed (or, once frozen, absolute) position
//                            + the constant CSS bob loop
//   .corner-island-inner  — the mouse-follow offset (see note below),
//                            and now also the crossfade's positioning
//                            context (position: relative)
//   .corner-island-img*   — the two stacked images themselves
// Keeping these transforms on separate elements from the crossfade
// means none of these animations fight over the same CSS property.
//
// Note: the original file's comment for `.corner-island-inner`
// referenced a mouse-follow script "below" that isn't actually present
// in this file (likely lives elsewhere in the build, or was removed
// before this snippet was captured) — left as-is rather than guessed
// at. Both <script> blocks actually at the bottom of this file are
// new: the hobby-section image swap described above, and the
// freeze-near-end-of-BonusIslandSection behavior.
---

<div class="corner-island" aria-hidden="true">
  <div class="corner-island-inner">
    <img
      class="corner-island-img corner-island-img--default"
      src="/personal-cv-page/images/front-island.svg"
      alt=""
    />
    <img
      class="corner-island-img corner-island-img--hobby"
      src="/personal-cv-page/images/front_island_cartoon_version.webp"
      alt=""
    />
  </div>
</div>

<style>
  .corner-island {
    position: fixed;
    bottom: -6vw;
    left: -10vw;
    width: min(55vw, 900px);
    z-index: 5;
    pointer-events: none;
    animation: bob 6s ease-in-out infinite;
  }

  /* Freeze state: swaps out of the viewport-relative `fixed`
     positioning above and pins the island at a specific point in the
     DOCUMENT instead, computed by the script below to be partway down
     BonusIslandSection (its vertical middle by default). `bottom` has
     to be explicitly cleared here since the base rule above sets it,
     and a `top` + `bottom` both being non-auto would fight each
     other. */
  .corner-island.is-frozen {
    position: absolute;
    top: var(--frozen-top, auto);
    bottom: auto;
  }

  .corner-island-inner {
    width: 100%;
    /* Positioning context for the absolutely-positioned hobby image
       below — the default image stays in normal flow and is what
       actually gives this element its height. */
    position: relative;
  }

  .corner-island-img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.6s ease;
  }

  /* The default (svg) image drives layout as normal. The hobby (webp)
     image is laid on top of it via absolute positioning so the two
     occupy the exact same box and can crossfade without any layout
     shift. Both start at their "not hobby section" opacity; the
     `.is-hobby` toggle below flips them. */
  .corner-island-img--default {
    opacity: 1;
  }

  .corner-island-img--hobby {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .corner-island.is-hobby .corner-island-img--default {
    opacity: 0;
  }

  .corner-island.is-hobby .corner-island-img--hobby {
    opacity: 1;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (max-width: 700px) {
    .corner-island {
      width: min(90vw, 620px);
      bottom: -12vw;
      left: -14vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .corner-island {
      animation: none;
    }

    /* Still swap images when the hobby section is reached, just
       instantly instead of via an animated fade. */
    .corner-island-img {
      transition: none;
    }
  }
</style>

<script>
  // Swaps the front island's artwork for the cartoon version while the
  // user is scrolled into HobbyIslandSection (id="section-hobbies" in
  // src/pages/index.astro), and swaps it back once they scroll past it
  // in either direction. Purely a class toggle — all the actual visual
  // work (crossfade) is the CSS above.
  //
  // rootMargin trims the observer's trigger zone to the vertical
  // center third of the viewport, so the swap happens once the hobby
  // section is meaningfully in view rather than the instant a single
  // pixel of it appears at the very edge of the screen.
  const hobbySection = document.querySelector("#section-hobbies");
  const cornerIslandForHobby = document.querySelector<HTMLElement>(".corner-island");

  if (hobbySection && cornerIslandForHobby) {
    const hobbyObserver = new IntersectionObserver(
      ([entry]) => {
        cornerIslandForHobby.classList.toggle("is-hobby", entry.isIntersecting);
      },
      { rootMargin: "-33% 0px -33% 0px" }
    );

    hobbyObserver.observe(hobbySection);
  }
</script>

<script>
  // Stops the fixed front island partway through BonusIslandSection
  // (id="section-bonus" in src/pages/index.astro), instead of letting
  // it keep hovering in front of everything all the way down to
  // OtherIslandSection (id="section-closing"), the very last section.
  // The freeze point is FREEZE_TARGET_FRACTION of the way down Bonus's
  // own height (0.5 = its vertical middle), plus an optional extra
  // FREEZE_BUFFER_PX nudge (positive moves the stop point higher up
  // the page, negative moves it lower). Tune either constant to move
  // where exactly it comes to rest.
  //
  // The trick: `position: fixed` and `position: absolute` use the same
  // coordinate math, just relative to the viewport vs. the document.
  // So instead of animating anything, we just measure, once, where the
  // island currently sits on screen (`islandTopViewport`, while it's
  // still `fixed`) and where the freeze target sits in the document
  // (`frozenTopPx`, derived from FREEZE_TARGET_FRACTION down Bonus's
  // own height, minus FREEZE_BUFFER_PX), and from that derive the
  // exact scrollY (`freezeAtScrollY`) at which those two coincide. Cross that
  // scrollY going down and we switch the island to `position: absolute;
  // top: <that same document position>` via the `.is-frozen` class —
  // visually nothing jumps, because the island's on-screen position at
  // that instant is identical either way. From then on the island is
  // ordinary document content again and scrolls away like anything
  // else. Cross back going up and it reverts to `fixed`.
  //
  // Measuring has to happen while NOT frozen (getBoundingClientRect()
  // on an already-`absolute` island would report frozen-state numbers,
  // not the normal fixed-state ones), so `measure()` always drops the
  // frozen class first if needed and restores it after.
  const FREEZE_TARGET_FRACTION = 0.5;
  const FREEZE_BUFFER_PX = 0;

  const cornerIslandForFreeze = document.querySelector<HTMLElement>(".corner-island");
  const bonusSection = document.querySelector<HTMLElement>("#section-bonus");

  if (cornerIslandForFreeze && bonusSection) {
    let freezeAtScrollY = 0;
    let frozenTopPx = 0;
    let isFrozen = false;

    function applyFrozen() {
      cornerIslandForFreeze!.style.setProperty("--frozen-top", `${frozenTopPx}px`);
      cornerIslandForFreeze!.classList.add("is-frozen");
      isFrozen = true;
    }

    function removeFrozen() {
      cornerIslandForFreeze!.classList.remove("is-frozen");
      isFrozen = false;
    }

    function measure() {
      const wasFrozen = isFrozen;
      if (wasFrozen) removeFrozen();

      const islandTopViewport = cornerIslandForFreeze!.getBoundingClientRect().top;
      const bonusRect = bonusSection!.getBoundingClientRect();
      const bonusTargetDoc =
        bonusRect.top + window.scrollY + bonusRect.height * FREEZE_TARGET_FRACTION;

      frozenTopPx = bonusTargetDoc - FREEZE_BUFFER_PX;
      freezeAtScrollY = frozenTopPx - islandTopViewport;

      if (wasFrozen) applyFrozen();
    }

    function syncFreezeState() {
      if (!isFrozen && window.scrollY >= freezeAtScrollY) {
        applyFrozen();
      } else if (isFrozen && window.scrollY < freezeAtScrollY) {
        removeFrozen();
      }
    }

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            syncFreezeState();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );

    // Re-measure on resize (vw-based sizing means the island's
    // dimensions change with viewport width) and once more on window
    // `load`, in case images above BonusIslandSection finish loading
    // late and shift its position after the initial measurement.
    window.addEventListener("resize", measure);
    window.addEventListener("load", measure);

    measure();
    syncFreezeState();
  }
</script>