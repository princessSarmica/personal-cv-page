---

import bgWebm from '../images/education_section/education_section_background.webm';
import bgMp4 from '../images/education_section/education_section_background.mp4';

interface Props {
  id: string;
  class?: string;
  eyebrow?: string;
  title: string;
  text: string;
}

const { id, class: className, eyebrow, title, text } = Astro.props;
---

<section class:list={['edu-section', className]} id={id}>
  <video
    class="edu-bg"
    width="556"
    height="466"
    autoplay
    loop
    muted
    playsinline
    preload="auto"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src={bgWebm} type="video/webm" />
    <source src={bgMp4} type="video/mp4" />
  </video>

  <div class="edu-grade" aria-hidden="true"></div>

  <div class="edu-stage">
    <div class="edu-rec edu-rec-corner" aria-hidden="true"><i></i> REC</div>
    <div class="edu-bar edu-bar-bottom" aria-hidden="true">
      <span class="edu-timecode">00:00:00:00</span>
      <span>CH 01 &middot; SP</span>
    </div>

    <div class="content">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      <div class="body-text" set:html={text} />
    </div>
  </div>
</section>

<script>
  const LOOP_MS = 13410;
  let timer: number | undefined;

  const pad = (n: number) => String(n).padStart(2, '0');

  function stop() {
    if (timer !== undefined) window.clearInterval(timer);
    timer = undefined;
  }

  function start() {
    stop();
    const el = document.querySelector<HTMLElement>('.edu-timecode');
    if (!el) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const t0 = performance.now();
    timer = window.setInterval(() => {
      const t = (performance.now() - t0) % LOOP_MS;
      const seconds = Math.floor(t / 1000);
      const frames = Math.floor(((t % 1000) / 1000) * 24);
      el.textContent = `00:${pad(Math.floor(seconds / 60))}:${pad(seconds % 60)}:${pad(frames)}`;
    }, 1000 / 24);
  }

  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', stop);
</script>

<style>
  .edu-section {
    --edu-lift: 15vw;
    --edu-ink: #e9ecff;
    --edu-dim: #9aa3c7;
    --edu-yellow: #f4c04e;
    --edu-pink: #ff4f9a;
    --edu-cyan: #3fe0ff;
    --edu-night: #070b16;
    --edu-bar: clamp(2rem, 5.5vh, 3.25rem);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: calc(42.64% - var(--edu-lift));
    background: var(--edu-night);
    color: var(--edu-ink);
  }

  .edu-stage {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    justify-items: start;
    padding: calc(var(--edu-lift) + var(--edu-bar) + 1rem) clamp(1.25rem, 6vw, 6rem) calc(var(--edu-bar) + 2rem);
  }

  .edu-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 50%;
    transform: scale(1.03);
    animation: edu-weave 0.5s steps(1, end) infinite;
    user-select: none;
    pointer-events: none;
  }

  @keyframes edu-weave {
    0%   { transform: scale(1.03) translate(0, 0); }
    25%  { transform: scale(1.03) translate(0.4px, -0.5px); }
    50%  { transform: scale(1.03) translate(-0.3px, 0.4px); }
    75%  { transform: scale(1.03) translate(0.2px, 0.3px); }
  }

  .edu-grade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(ellipse at 58% 50%, transparent 55%, rgba(4, 7, 18, 0.5) 100%);
  }

  .edu-scanlines {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.12;
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.9) 0,
      rgba(0, 0, 0, 0.9) 1px,
      transparent 1px,
      transparent 3px
    );
  }

  .edu-grain {
    position: absolute;
    inset: -10%;
    z-index: 3;
    pointer-events: none;
    opacity: 0.2;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    animation: edu-grain 0.6s steps(1, end) infinite;
  }

  @keyframes edu-grain {
    0%   { transform: translate(0, 0); }
    20%  { transform: translate(-3%, 2%); }
    40%  { transform: translate(2%, -3%); }
    60%  { transform: translate(-2%, -2%); }
    80%  { transform: translate(3%, 3%); }
  }

  .edu-bar {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 4;
    height: var(--edu-bar);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(1.25rem, 6vw, 6rem);
    background: #000;
    color: var(--edu-dim);
    font-family: 'Share Tech Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: clamp(0.65rem, 1.4vw, 0.85rem);
    letter-spacing: 0.16em;
    pointer-events: none;
  }

  .edu-bar-top { top: 0; }
  .edu-bar-bottom { bottom: 0; }

  .edu-rec {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--edu-pink);
  }

  .edu-rec-corner {
    position: absolute;
    top: 1.5rem;
    right: clamp(1.25rem, 6vw, 6rem);
    z-index: 4;
    font-family: 'Share Tech Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: clamp(0.8rem, 1.5vw, 1rem);
    letter-spacing: 0.16em;
    padding: 0.3em 0.7em;
    background: rgba(7, 11, 22, 0.7);
    pointer-events: none;
  }

  .edu-rec i {
    width: 0.65em;
    height: 0.65em;
    border-radius: 50%;
    background: var(--edu-pink);
    box-shadow: 0 0 0.6em var(--edu-pink);
    animation: edu-blink 1.2s steps(1, end) infinite;
  }

  @keyframes edu-blink {
    0%, 55% { opacity: 1; }
    56%, 100% { opacity: 0.15; }
  }

  .edu-timecode {
    font-variant-numeric: tabular-nums;
  }

  .content {
    position: relative;
    z-index: 5;
    width: min(100%, 40rem);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: rgba(7, 11, 22, 0.72);
    border: 1px solid rgba(244, 192, 78, 0.35);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 1.5rem 3rem rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(3px);
  }

  .content::before,
  .content::after {
    content: '';
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--edu-yellow);
    pointer-events: none;
  }
  .content::before {
    top: -6px;
    left: -6px;
    border-right: 0;
    border-bottom: 0;
  }
  .content::after {
    bottom: -6px;
    right: -6px;
    border-left: 0;
    border-top: 0;
  }

  .eyebrow {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.15rem 0.6rem;
    font-family: 'Share Tech Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0b0f1c;
    background: var(--edu-yellow);
  }

  h2 {
    margin: 0 0 1.1rem;
    font-family: 'Chakra Petch', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1.05;
    color: #fff;
    text-shadow:
      2px 0 0 rgba(255, 79, 154, 0.75),
      -2px 0 0 rgba(63, 224, 255, 0.65);
  }

  .body-text {
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    line-height: 1.55;
    color: var(--edu-ink);
  }

  .body-text :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .body-text :global(li) {
    position: relative;
    margin: 0.55rem 0;
    padding-left: 1.4rem;
  }

  .body-text :global(li)::before {
    content: '\25B8';
    position: absolute;
    left: 0;
    color: var(--edu-yellow);
  }

  .body-text :global(ul ul) {
    margin-top: 0.3rem;
  }

  .body-text :global(a) {
    color: var(--edu-cyan);
  }

  @media (max-width: 900px) {
    .edu-section {
      --edu-lift: 24vw;
    }
    .edu-bar {
      padding: 0 4.25rem;
    }
    .content {
      background: rgba(7, 11, 22, 0.8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edu-bg,
    .edu-grain,
    .edu-rec i {
      animation: none;
    }
  }
</style>
