---
// src/components/IntroIslandSection.astro
//
// First section on the page — sits before EducationIslandSection.
// Space theme, per your request: a solid black background with a
// regular grid of small white dots (most dim, a random sparse handful
// bright), rendered on a `<canvas>` so the pattern can react live to
// the cursor — dots near the pointer glow brighter and slightly
// bigger, easing back down once the cursor moves away, so the pattern
// visibly "shifts" as you move through it instead of being static.
//
// This replaces the previous version of this section, which had a sky
// photo (`backgroundImage`) and a cloud mascot with a hover-triggered
// smile (`cloudImage`/`cloudSmileImage`). Per your call: the cloud is
// dropped entirely for a clean space look, so those props are gone —
// this section is now just the star-grid canvas behind the name/
// titles text, no other props needed.
//
// Two lines of text, unchanged from before:
//   - `name`   -> "Name Surname", rendered noticeably bigger than any
//     other section's heading (`clamp(2.75rem, 6vw, 4.5rem)` vs the
//     usual `clamp(2rem, 4vw, 3rem)` for h2 elsewhere), since this is
//     the one place on the page that should read as a name/title card.
//   - `titles` -> a single line underneath, e.g. "Title 1, Title 2,
//     Title 3" — smaller, muted, same treatment as `.body-text`
//     elsewhere. Both recolored to light tones (previously dark, meant
//     for a light sky background) so they read against the new black
//     background.
//
// The star grid (`.intro-stars`, a `<canvas>`):
//   - A perfectly regular grid (no jitter — matches the reference
//     image you sent, which is a clean, evenly spaced grid rather than
//     a scattered one), spacing controlled by `SPACING` below.
//   - Each dot's "is this one of the bright ones?" call, and its exact
//     base opacity/size within its bright-or-dim band, are decided
//     once per dot via a deterministic hash of its grid column/row
//     (`hash()`) — so the "random" pattern is stable across redraws/
//     resizes rather than reshuffling every time, the same way you'd
//     expect a fixed star field to behave.
//   - Cursor reactivity: dots within `INFLUENCE_RADIUS` of the pointer
//     ease toward extra brightness/size (`boost`), and ease back down
//     once the cursor moves away — this is what makes the pattern
//     "change a bit as you move your cursor through it" per your
//     request, on top of the sparse bright dots that are there at
//     rest.
//   - Performance: the resting grid (the vast majority of dots, which
//     never change) is rendered ONCE to an offscreen bitmap
//     (`restingBitmap`) and then just blitted (`drawImage`) each
//     frame; only the small, currently-active set of cursor-boosted
//     dots is redrawn on top individually. This keeps the per-frame
//     cost proportional to how many dots are actually glowing near the
//     cursor, not the size of the whole grid (which can be a couple
//     thousand dots on a big screen).
//   - The animation loop only runs while at least one dot has a
//     nonzero boost — it stops itself (no `requestAnimationFrame`
//     scheduled) once everything has eased back to rest, rather than
//     redrawing forever in the background.
//   - Resizing: a `ResizeObserver` on the canvas itself (not just a
//     `window resize` listener) rebuilds the grid and resting bitmap
//     whenever the section's rendered size actually changes, so it
//     stays correct across breakpoints/orientation changes/etc.
//   - Seamless handoff into InBetweenSection1: this section's height is
//     basically never an exact multiple of `SPACING`, so without any
//     correction the row grid would restart fresh at y=0 of THIS
//     canvas, landing its rows at a different offset than
//     InBetweenSection1's own grid starting at y=0 of ITS canvas right
//     below — visible as an irregular gap/seam right at the boundary
//     (reported as "a line of dots that is cut away"). Fixed by phase-
//     shifting the row grid to line up with the page's global 24px
//     rhythm instead of this canvas's own local top edge — see the
//     `rowPhase` comment on `resize()` below.
//   - `prefers-reduced-motion: reduce`: the grid still renders (it's
//     the section's whole background, not optional decoration), but
//     no mousemove listener or animation loop is attached at all —
//     what you get is the static resting pattern with zero motion,
//     same "show a plain static state instead of nothing" convention
//     used everywhere else in this codebase.
//
// Dropped `halftone-hover` from this section's classes (the page-wide
// cursor "halftone spotlight" effect from Layout.astro): that overlay
// is its own dot pattern meant to tint whatever background a section
// has, and layering it on top of this section's OWN dot pattern would
// just be two competing dot textures fighting each other visually.
// Every other section keeps that effect as before — this is scoped to
// just this section.
//
// No seam-fade classes any more — the shared fade-band system that
// used to blend section edges together was removed per your request,
// so this section now just butts directly against InBetweenSection1
// below it. Still carries `.sky-chain` so the gap between them stays
// collapsed to 0.
//
// Usage:
//   <IntroIslandSection
//     id="section-intro"
//     name="Name Surname"
//     titles="Title 1, Title 2, Title 3"
//   />

interface Props {
  id: string;
  name: string;
  titles: string;
}

const { id, name, titles } = Astro.props;
---

<section class="intro-section sky-chain" id={id}>
  <canvas class="intro-stars" aria-hidden="true"></canvas>

  <div class="content">
    <h1>{name}</h1>
    <p class="titles">{titles}</p>
  </div>
</section>

<script>
  // See the top-of-file comment for the overall design. Everything below is scoped to this one `<canvas>` — nothing here is shared globally the way the `.parallax-inner` drift script in the other sections is.
  //
  // Wrapped in `astro:page-load` (fires on the initial load AND after
  // every <ClientRouter /> navigation -- see src/layouts/Layout.astro)
  // instead of running at the top level: a language switch replaces
  // this `<canvas>` with a freshly-parsed one, and this module itself
  // only executes once, so without re-running this init on every
  // navigation the star field would go dead (and the ResizeObserver
  // would be left watching a detached canvas) after the first language
  // switch. `cleanupIntroStars` tears down the previous navigation's rAF
  // loop, `mousemove`/`mouseout` listeners, ResizeObserver, and pending
  // resize-debounce timer first, so switching languages back and forth
  // all session never piles up duplicates of any of them running at
  // once (`window`/`document` are never recreated by a soft
  // navigation).
  let cleanupIntroStars: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    cleanupIntroStars?.();

    const controller = new AbortController();
    const { signal } = controller;
    let resizeObserver: ResizeObserver | null = null;
    const rafIdHolder: { get: () => number | null } = { get: () => null };
    const resizeTimerHolder: { get: () => ReturnType<typeof setTimeout> | null } = {
      get: () => null,
    };

    const canvas = document.querySelector<HTMLCanvasElement>(".intro-stars");
    const ctx = canvas?.getContext("2d") ?? null;

    if (canvas && ctx) {
      const SPACING = 24; // px between grid points, both axes
      const BRIGHT_CHANCE = 0.035; // fraction of dots that start "lit" at rest
      const INFLUENCE_RADIUS = 130; // px, cursor reach before a dot's boost is 0
      const EASE = 0.15;
      const MAX_DPR = 2; // cap device-pixel-ratio for perf on very high-density screens

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      // Deterministic pseudo-random in [0, 1) from two integers — same
      // (col, row) always produces the same value, so each dot's
      // "is it bright" / exact opacity call is stable across rebuilds
      // instead of reshuffling on every resize.
      function hash(x: number, y: number) {
        const v = Math.sin(x * 12.9898 + y * 78.233) * 43758.5453;
        return v - Math.floor(v);
      }

      interface Dot {
        x: number;
        y: number;
        isBright: boolean;
        baseAlpha: number;
        baseRadius: number;
        boost: number;
      }

      let dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
      let width = 0;
      let height = 0;
      let cols = 0;
      let rows = 0;
      let rowPhase = 0; // see resize() — kept in this scope so activateNearby() can undo the shift
      let dots: Dot[] = [];
      let restingBitmap: HTMLCanvasElement | null = null;
      const active = new Set<number>();

      let mouseX = -99999;
      let mouseY = -99999;
      let rafId: number | null = null;
      rafIdHolder.get = () => rafId;

      // `rowPhase` shifts every row's y-coordinate so the grid lines up
      // with the PAGE's global 24px rhythm instead of restarting fresh
      // at this canvas's own top edge — see the comment on `resize()`
      // below for why (this is what keeps the dot grid seamless across
      // the boundary into InBetweenSection1, which does the exact same
      // thing). Row indices used for `hash()`/`active` bookkeeping stay
      // plain 0..rows-1 integers regardless — only the drawn `y` value
      // is shifted.
      function buildDots(rowPhase: number) {
        cols = Math.ceil(width / SPACING) + 1;
        rows = Math.ceil((height + rowPhase) / SPACING) + 1;
        dots = [];
        for (let row = 0; row < rows; row++) {
          for (let col = 0; col < cols; col++) {
            const roll = hash(col * 3 + 1, row * 7 + 5);
            const isBright = roll < BRIGHT_CHANCE;
            dots.push({
              x: col * SPACING,
              y: row * SPACING - rowPhase,
              isBright,
              baseAlpha: isBright
                ? 0.75 + hash(col, row + 11) * 0.25
                : 0.08 + hash(col + 11, row) * 0.14,
              baseRadius: isBright ? 1.7 : 1.05,
              boost: 0,
            });
          }
        }
        active.clear();
      }

      // The vast majority of dots never change frame-to-frame — render
      // them once to an offscreen bitmap so each animation frame only
      // has to `drawImage` (cheap) plus redraw the handful of currently
      // cursor-boosted dots, instead of redrawing the whole grid.
      function renderResting() {
        const bitmap = document.createElement("canvas");
        bitmap.width = canvas.width;
        bitmap.height = canvas.height;
        const rctx = bitmap.getContext("2d");
        if (!rctx) return;

        rctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        for (const d of dots) {
          rctx.beginPath();
          rctx.fillStyle = `rgba(255, 255, 255, ${d.baseAlpha.toFixed(3)})`;
          if (d.isBright) {
            rctx.shadowColor = "rgba(255, 255, 255, 0.85)";
            rctx.shadowBlur = 5;
          } else {
            rctx.shadowBlur = 0;
          }
          rctx.arc(d.x, d.y, d.baseRadius, 0, Math.PI * 2);
          rctx.fill();
        }

        restingBitmap = bitmap;
      }

      function drawFrame() {
        ctx.clearRect(0, 0, width, height);
        if (restingBitmap) {
          ctx.drawImage(restingBitmap, 0, 0, width, height);
        }

        for (const idx of active) {
          const d = dots[idx];
          if (!d || d.boost <= 0.01) continue;
          const alpha = Math.min(1, d.baseAlpha + d.boost * 0.7);
          const radius = d.baseRadius + d.boost * 1.6;
          ctx.beginPath();
          ctx.fillStyle = `rgba(255, 255, 255, ${alpha.toFixed(3)})`;
          ctx.shadowColor = "rgba(255, 255, 255, 0.9)";
          ctx.shadowBlur = 4 + d.boost * 8;
          ctx.arc(d.x, d.y, radius, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.shadowBlur = 0;
      }

      function resize() {
        const rect = canvas.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // This canvas's top edge in PAGE (document) coordinates — adding
        // back the current scroll offset cancels it out, so this is the
        // same value regardless of where the page happens to be scrolled
        // when resize() runs. Used only to phase-shift the row grid (see
        // `buildDots()`) so it lines up with the page's global 24px
        // rhythm instead of always starting a fresh row right at this
        // canvas's own top — otherwise, since this section's height is
        // basically never an exact multiple of SPACING, the row spacing
        // right at the seam into InBetweenSection1 (which sits flush
        // against this section's bottom, no gap) would be off — either
        // squeezed together or gapped wider than the normal 24px rhythm,
        // reading as a visible cut/seam in the dot pattern. Both this
        // section and InBetweenSection1 compute this the same way
        // independently, so any two adjacent sections using this
        // technique line up automatically without needing to coordinate.
        const pageTop = rect.top + window.scrollY;
        rowPhase = ((pageTop % SPACING) + SPACING) % SPACING;

        buildDots(rowPhase);
        renderResting();
        drawFrame();
      }

      resize();

      let resizeTimer: ReturnType<typeof setTimeout> | null = null;
      resizeTimerHolder.get = () => resizeTimer;
      const ro = new ResizeObserver(() => {
        // Small debounce — a resize can fire many times in quick
        // succession (e.g. during a window drag), and rebuilding the
        // grid + resting bitmap on every single one is wasted work.
        if (resizeTimer) clearTimeout(resizeTimer);
        resizeTimer = setTimeout(resize, 120);
      });
      ro.observe(canvas);
      resizeObserver = ro;

      if (!prefersReducedMotion) {
        function activateNearby(x: number, y: number) {
          // Row lookups need `+ rowPhase` to undo the shift `buildDots()`
          // applied to each dot's actual `y` (see the comment on
          // `resize()`) — column lookups don't, since x is unshifted.
          const minCol = Math.max(0, Math.floor((x - INFLUENCE_RADIUS) / SPACING));
          const maxCol = Math.min(cols - 1, Math.ceil((x + INFLUENCE_RADIUS) / SPACING));
          const minRow = Math.max(0, Math.floor((y + rowPhase - INFLUENCE_RADIUS) / SPACING));
          const maxRow = Math.min(rows - 1, Math.ceil((y + rowPhase + INFLUENCE_RADIUS) / SPACING));

          for (let row = minRow; row <= maxRow; row++) {
            for (let col = minCol; col <= maxCol; col++) {
              active.add(row * cols + col);
            }
          }
        }

        function ensureLoopRunning() {
          if (rafId === null) {
            rafId = requestAnimationFrame(tick);
          }
        }

        function tick() {
          let anyActive = false;

          for (const idx of active) {
            const d = dots[idx];
            if (!d) {
              active.delete(idx);
              continue;
            }

            const dx = d.x - mouseX;
            const dy = d.y - mouseY;
            const dist = Math.hypot(dx, dy);
            const target = dist < INFLUENCE_RADIUS ? 1 - dist / INFLUENCE_RADIUS : 0;

            d.boost += (target - d.boost) * EASE;

            if (d.boost < 0.01 && target === 0) {
              d.boost = 0;
              active.delete(idx);
            } else {
              anyActive = true;
            }
          }

          drawFrame();
          rafId = anyActive ? requestAnimationFrame(tick) : null;
        }

        window.addEventListener(
          "mousemove",
          (e) => {
            const rect = canvas.getBoundingClientRect();
            mouseX = e.clientX - rect.left;
            mouseY = e.clientY - rect.top;
            activateNearby(mouseX, mouseY);
            ensureLoopRunning();
          },
          { signal }
        );

        // Classic cross-browser "cursor left the whole browser window"
        // check (`relatedTarget`/`toElement` both null) — without this,
        // moving the cursor off the page entirely leaves `mouseX`/
        // `mouseY` at their last in-window position, so any dots that
        // were lit at that moment would stay lit forever (no more
        // mousemove events to ease them back down).
        document.addEventListener(
          "mouseout",
          (e) => {
            const leftWindow = !e.relatedTarget && !(e as any).toElement;
            if (leftWindow) {
              mouseX = -99999;
              mouseY = -99999;
              ensureLoopRunning();
            }
          },
          { signal }
        );
      }
    }

    cleanupIntroStars = () => {
      controller.abort();
      resizeObserver?.disconnect();
      const raf = rafIdHolder.get();
      if (raf !== null) cancelAnimationFrame(raf);
      const timer = resizeTimerHolder.get();
      if (timer !== null) clearTimeout(timer);
    };
  });
</script>

<style>
  .intro-section {
    position: relative;
    /* `z-index: 0` alongside `position: relative` — without an
       explicit z-index, this element wouldn't establish its OWN
       stacking context, and `.intro-stars` below (z-index: -1) would
       then be resolved against the nearest ANCESTOR that does (further
       up the page), escaping past this section's own background
       instead of layering on top of it. Concretely: `.intro-section`'s
       `background: #000` would end up painting AFTER (covering)
       `.intro-stars`'s canvas content, since a positioned element with
       z-index:auto paints later than a negative-z-index descendant of
       some ancestor stacking context — the exact bug that made the
       star grid invisible against the black background. Forcing a
       z-index here makes `.intro-section` its own stacking context, so
       painting order is scoped to just its own children as expected:
       this section's background first, then `.intro-stars` on top of
       it, then the positive-z-index content on top of that. */
    z-index: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 6vw, 6rem);
    overflow: hidden;
    background: #000;
  }

  /* Full-bleed, behind everything else in the section. */
  .intro-stars {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .content {
    position: relative;
    z-index: 2;

    width: min(36ch, 100%);
    margin: 0 auto;

    text-align: left;
  }

  h1 {
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    margin: 0 0 1rem;
    color: #f5f6fa;
  }

  .titles {
    font-size: 1.05rem;
    color: #9aa3ba;
    margin: 0;
  }

  @media (max-width: 640px) {
    .content {
      width: min(36ch, 100%);
      padding-inline: 1.5rem;
    }
  }

  /* Phones in LANDSCAPE ("mobile wide screen" per your report): the
     section is now genuinely SHORT (small `vh`) even though it's
     WIDE (large `vw`) -- `h1`'s `6vw` term above keeps growing with
     that extra width even though there's no extra height to fit the
     wrapped lines it produces. `.content` gets noticeably wider here
     (nothing else sits near it in this section, so there's no
     collision risk), giving a line of text more room before it needs
     to wrap at all, and both font sizes below switch from scaling off
     viewport WIDTH to viewport HEIGHT, tying text size to whichever
     dimension is actually scarce in this orientation instead of the
     one that isn't. `max-height: 500px` catches real landscape phones
     (a portrait phone is always taller than that) without also
     catching a landscape TABLET (iPad landscape is 768px tall, well
     clear of this), and `orientation: landscape` on top of that keeps
     a genuinely short DESKTOP window from picking up phone-tuned
     sizing by accident. */
  @media (max-height: 500px) and (orientation: landscape) {
    .content {
      width: min(46ch, 62%);
    }

    h1 {
      font-size: clamp(1.8rem, 9vh, 2.75rem);
    }

    .titles {
      font-size: clamp(0.85rem, 4vh, 1.05rem);
    }
  }
</style>
