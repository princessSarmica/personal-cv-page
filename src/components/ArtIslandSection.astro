---
// src/components/ArtIslandSection.astro
//
// A variant of Section.astro for sections that have TWO flanking
// illustrations (top-left and bottom-right) sitting behind the centered
// text, instead of one full-bleed backdrop.
//
// Both illustrations share the same animation style as CornerIsland.astro:
// a constant CSS bob loop on the outer wrapper, plus a JS-driven
// mouse-repel drift on an inner wrapper (kept on separate elements so
// the two transforms don't fight each other — see the comment in
// CornerIsland.astro for why).
//
// The mouse-driven part is a proximity REPEL: each island tracks the
// vector from the cursor to its own rest position and drifts away
// along that vector, with the push fading to zero once the cursor is
// further than `influenceRadius` away. So pointing at/near an island
// pushes it off in the opposite direction; move the cursor elsewhere
// and it eases back to rest.
//
// Sizing is deliberately NOT reduced at narrow viewports — the images
// stay the same size as desktop and instead overflow past the
// left/right edges — that overflow is caught by `overflow-x: hidden`
// on `html` in Layout.astro so it doesn't cause horizontal scrolling.
//
// Positioning is fluid instead of a single mobile breakpoint. A plain
// `left: 16rem` (fine on a wide screen) doesn't scale down as the
// viewport narrows, so anywhere between "wide" and the old 640px
// mobile override, the offset stayed frozen at its desktop value while
// the section itself kept shrinking — which is exactly why the top
// island crept toward the middle (and behind the text) on in-between
// screen sizes instead of just at the phone breakpoint.
//
// Fix: each offset below is `clamp(mobileValue, calc(a + b*vw), desktopValue)`.
// That's a straight line through two anchor points —
// viewport width 640px -> the old mobile value, 1280px -> the old
// desktop value — so the island's corner offset scales continuously
// with the viewport instead of jumping between two fixed states. Below
// 640px it holds at the mobile value; above 1280px it holds at the
// desktop value; in between it interpolates. If you want to re-tune
// the look, it's easiest to pick new values at those two widths and
// re-derive the calc() (see the component's git history / ask for the
// derivation), rather than hand-tweaking the calc() coefficients
// directly.
//
// Background: split into TWO layers instead of one flat image, per
// your request — `moonBackground` (the moon, static) and
// `cloudsBackground` (a seamlessly-tileable clouds texture that drifts
// left-to-right and loops forever). `min-height: 100vh` on the section
// itself is still the goal for a consistent height across every screen
// size. `.art-moon-bg` uses `background-size: cover` — briefly tried
// sizing by height only (`auto 100%`) per your request to stop
// shortening the moon vertically on wider screens, but that left
// visible white space on screens wider (in aspect ratio) than the moon
// image itself, which you didn't want either — back to `cover`, which
// guarantees full edge-to-edge coverage with no gaps, cropping
// whichever dimension needs it least. Same reasoning applies across
// Computer/Education/Achievement/Bonus.
//
// One more layer on top of that: on a short/wide viewport, `cover`
// still has to crop SOMETHING to avoid a gap, and per your follow-up
// that "something" shouldn't ever be the image's own height either —
// you'd rather scroll than see it shortened. Fixed by adding
// `aspect-ratio: 16 / 9` (the moon image's real ratio) alongside
// `min-height`/`width: 100%` on `.art-section` below, so the section
// itself grows taller than one screen on those viewports instead of
// asking `cover` to crop into the height — see the comment there.
//
// Implementation: `.art-moon-bg` is a single absolutely-positioned
// full-bleed layer, unanimated, using `background-image` +
// `background-size: cover` (a single non-repeating image can be
// cropped freely with no seam to protect). `.art-clouds-bg`
// is a clipped (`overflow: hidden`) full-bleed layer containing a
// `.art-clouds-track` — two identical `<img>` copies of the clouds
// texture side by side (real `<img>` elements, not `background-image`,
// sized by `height: 100%; width: auto` for the same full-height/crop-
// the-sides reasoning — and specifically NOT `cover`, since `cover`
// would crop each tile to its own box and, because that crop lands
// centered, both tiles would show the same cropped middle slice of the
// texture instead of its true left/right edges, producing a visible
// cut at the tile boundary instead of a seamless join) — animated via
// `transform: translateX` from -50% to 0%. The track is sized with
// `width: max-content` (fits its two children exactly), so
// `translateX(-50%)` always shifts by exactly one tile's rendered
// width, whatever that width is. Because the two tiles are pixel-
// identical and the texture is seamlessly tileable, the track loops
// infinitely with no visible seam: `translateX` (not an animated
// `background-position` percentage, which is ambiguous once
// `background-size` is also a percentage) is what makes this reliable.
// Animating FROM -50% TO 0% specifically is what makes the visible
// motion read as left-to-right (the reverse would drift right-to-left).
//
// Both layers sit at NEGATIVE z-index (-2 for the clouds, -1 for the
// moon, moon in front of clouds so it stays visible instead of being
// covered by the drifting clouds texture) so they stay behind the
// foreground content/islands (z-index: 1/2).
//
// No seam-fade classes any more — the shared fade-band system that
// used to blend section edges together was removed per your request,
// so this section now just butts directly against EducationIslandSection
// above it and ComputerIslandSection below it.
//
// New: optional `topImageLoading` / `bottomImageLoading` props — your
// left_top_art_island_loading.webp and bottom_right_art_island_loading.webp,
// red-lined triangulated wireframe / low-poly mesh versions of each
// island's artwork. The first time EITHER island is FULLY in view
// (the entire island, not just part of it) that island (independently
// of the other) plays a one-time two-phase "materialize" animation
// instead of just appearing:
//
//   1. Materialize (~1.2s): the wireframe sweeps into view bottom-to-
//      top via an animated `clip-path`, with a red glow
//      (`filter: drop-shadow(...)`) pulsing in and back out — meant to
//      read as the low-poly mesh "constructing itself" on screen,
//      matching the wireframe look in the reference image you sent.
//   2. Deconstruct (~0.9s): the wireframe retreats using the exact
//      same clip-path sweep + red-glow beats as step 1, just played
//      backwards, while the final artwork fades in underneath — reads
//      as the mesh resolving into the real image, mirroring how it
//      first constructed itself.
//
// Each prop is independent — pass one, both, or neither. Whichever
// island(s) get a `...Loading` image go through the reveal; an island
// without one just renders its final image plainly, like before.
//
// Implemented as two stacked images inside an `.art-island-reveal`
// wrapper (same nested-stack technique as `.intro-cloud-inner`/
// `.cloud-smile` in IntroIslandSection.astro, `.achievement-glitch-
// swap` in AchievementIslandSection.astro, etc.) — the final image
// sits in normal flow at `opacity: 0` until phase 2, the loading image
// is absolutely positioned on top of it and animates through phase 1.
// This wrapper only exists in the markup for an island whose
// `...Loading` prop is actually passed; without it, that island's
// image renders exactly as before (no wrapper, no reveal behavior,
// immediate normal display). Both islands share the exact same
// `.art-island-reveal*` class names and `@keyframes` — there's nothing
// image-specific about the animation itself, so nothing needs
// duplicating per island.
//
// Triggering is a one-shot `IntersectionObserver` per `.art-island-
// reveal` element in the script below (not a scroll listener) — since
// there can now be up to two of these on the page (top and bottom),
// the script queries all of them and sets up an independent observer
// for each, so the top island materializing doesn't have any bearing
// on when (or whether) the bottom one does, and vice versa.
// `observer.disconnect()` right after each element's first
// intersection means it can only ever play once per page load, per
// your request ("the first time it comes into view") — using
// `threshold: 1.0` so that "into view" means the ENTIRE island, not
// just a sliver of it. It only touches
// `opacity`/`clip-path`/`filter` on that reveal wrapper's own
// children, so it doesn't interact with (or get overridden by) the
// bob loop or mouse-repel drift already applied higher up on
// `.art-island-top`/`.art-island-bottom`/`.art-island-inner` — those
// keep running throughout, on separate elements, same reasoning as
// CornerIsland.astro's split.
//
// Once an island's entrance sequence has fully played out, hovering
// over it replays the same wireframe sweep on demand: the mesh sweeps
// back in for as long as the cursor is over the island's artwork, and
// sweeps back out the moment it leaves — same `materialize`/
// `dematerialize` keyframes as the entrance, just retriggered
// indefinitely by the cursor instead of a one-shot timer. Detection is
// a point-in-rect check against a shared mousemove position (same
// proximity-watcher approach as AchievementIslandSection.astro's
// glitch effects) rather than real `:hover`/`mouseenter`, because
// these islands are `pointer-events: none` — decorative background
// art, not meant to intercept clicks — so native hover events never
// fire on them.
//
// Under `prefers-reduced-motion: reduce`, the whole sequence — entrance
// AND hover — is skipped: each reveal's final image is forced to
// `opacity: 1` and its loading image to `display: none`
// unconditionally in CSS, so the final artwork just shows immediately
// and stays put.
//
// New: you'd previously added a whole separate InBetweenSection2
// between EducationIslandSection and this one, just to get its own
// looping clouds texture to poke up above the seam and partly behind
// Education's building artwork. After living with it, you decided
// that was more section than the effect needed and asked instead for
// THIS section's own `.art-clouds-bg` to simply bleed a bit higher —
// so InBetweenSection2 has been removed from the page (the component
// file itself is left in place, unused, rather than deleted, since
// deleting files needs your explicit go-ahead) and `.art-clouds-bg`
// now reaches above this section's own top edge to produce the same
// overlap directly, with no extra section in between.
//
// Mechanically this is the exact technique InBetweenSection2 used for
// its overlap, just applied to `.art-clouds-bg` instead of a
// dedicated wrapper: swapping its old `inset: 0` for an explicit
// `top: -35vh; left: 0; right: 0; bottom: 0;` keeps the bottom edge
// pinned to the section's own bottom (unchanged) while extending the
// top edge up above the section's top border. This started at -12vh
// (the amount InBetweenSection2 used), but after seeing it live you
// sent a screenshot with a red line marking the actual building base
// of EducationIslandSection and asked for the clouds to reach all the
// way up to that line — the sandy ground strip between the education
// building and where the clouds used to start was still showing
// through at -12vh, so the offset was increased to -35vh to close
// that gap. If -35vh over- or under-shoots the red line on your
// screen, the fix is just nudging this one number further (more
// negative reaches higher, less negative reaches less high) — nothing
// else about the technique changes. Because `.art-clouds-track`
// and `.art-clouds-tile` are both sized relative to their container's
// height (`height: 100%`), taller container -> taller (and
// proportionally wider, since tile width is `auto`) clouds tiles: the
// same source texture simply renders larger within a taller box, so
// more of its vertical extent reaches above the section's own edge
// instead of being confined flush to it.
//
// Follow-up bug: going from -12vh to -35vh looked IDENTICAL on your
// screen — no visible change at all, not just "not enough." That
// dead giveaway meant the geometry was never the problem: something
// was fully occluding the clouds in that zone regardless of how far
// up they reached. The culprit was `.education-section`'s own
// `background: #40CAEC` fallback color (see EducationIslandSection.astro),
// which covers that section's ENTIRE box, not just the parts its
// artwork doesn't paint over — that flat blue, showing through the
// artwork's transparent cutout notches, is what you were actually
// seeing, not empty space Art's clouds could already reach into.
//
// Root cause, precisely: `.art-section` had NO explicit `z-index` of
// its own (it's plain `position: relative`), which meant it never
// created its own local stacking context — so `.art-clouds-bg`'s
// `z-index: -2` escaped all the way up to the page's ROOT stacking
// context, where "negative z-index" is its own paint step that
// happens strictly BEFORE "in-flow / positioned-but-z-index-auto"
// content — the step `.education-section`'s own box (also `position:
// relative`, z-index left at its default `auto`) falls into. Painting
// order, not DOM order, decides this: negative-z-index descendants
// always paint before z-index:auto ones at the same stacking level,
// no matter which one comes later in the markup. So Art's clouds were
// structurally incapable of ever appearing in front of Education's
// flat background — extending them further up couldn't fix that,
// which is exactly the "same place as before" you saw.
//
// Fix: `.art-section` now gets an explicit `z-index: 0;` of its own
// (below), the same pattern InBetweenSection2 used for the same
// reason. This makes `.art-section` establish its OWN local stacking
// context, so everything inside it — clouds at -2, moon at -1,
// foreground content at 1/2 — keeps its existing relative order,
// completely unaffected. What changes is how `.art-section` AS A
// WHOLE now competes at the root level: an explicit `z-index: 0`
// stacking context and a `z-index: auto` positioned box (Education's
// section) are painted in the SAME step, and same-step ties break by
// DOM order — Art comes after Education in the markup, so Art's
// entire composited section now paints in FRONT of Education's own
// background layer, letting the clouds show through in the overlap
// zone. Education's actual foreground artwork is unaffected and stays
// on top regardless, since its `z-index: 1` is a genuinely higher
// number than Art's new `0` — the building/ground drawing itself
// still visually covers the clouds exactly where it's opaque; it's
// only Education's flat fallback color, behind that artwork, that
// Art's clouds now win against.
//
// No `overflow: hidden` on `.art-section` itself (see the comment on
// that rule below) is what lets the taller clouds layer bleed upward
// at all once it's no longer being hidden behind Education's
// background. -35vh is untested with this fix in place (the earlier
// attempts were invisible regardless of the number), so treat it as a
// first guess to react to rather than a tuned value.
//
// New: you separately edited `art_island_moon_background.webp` to add
// a fade at its bottom (and a shorter one at its top) via the alpha
// channel, wanting the moon to bleed into ComputerIslandSection below
// instead of being cropped at this section's bottom edge. Two attempts
// at rescaling the image to compensate for that fade (so the "real"
// artwork stayed the same apparent size) both missed what you
// actually wanted, and you reverted this file back to the plain
// `background-image` + `cover` version. The fix that's actually in
// place now is much simpler — see the comment on `.art-moon-bg`
// itself, below: its box is just shifted down by `20vh` as a whole,
// same height, same `cover` scale as always, nothing recalculated.
//
// Usage:
//   <ArtIslandSection
//     id="art-skills"
//     eyebrow="Island 01"
//     title="Lorem Ipsum Dolor"
//     text="Lorem ipsum dolor sit amet..."
//     topImage="/images/left_top_art_island.svg"
//     topImageLoading="/images/left_top_art_island_loading.webp"
//     bottomImage="/images/right_bottom_art_island.svg"
//     bottomImageLoading="/images/bottom_right_art_island_loading.webp"
//     moonBackground="/images/art_island_moon_background.webp"
//     cloudsBackground="/images/art_island_clouds_background.webp"
//   />

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  text: string;
  topImage: string;
  topImageLoading?: string;
  bottomImage: string;
  bottomImageLoading?: string;
  moonBackground: string;
  cloudsBackground: string;
}

const {
  id,
  eyebrow,
  title,
  text,
  topImage,
  topImageLoading,
  bottomImage,
  bottomImageLoading,
  moonBackground,
  cloudsBackground,
} = Astro.props;
---

<section
  class="art-section sky-chain halftone-hover"
  id={id}
>
  <div class="art-moon-bg" style={`background-image: url(${moonBackground});`} aria-hidden="true"></div>
  <div class="art-clouds-bg" aria-hidden="true">
    <div class="art-clouds-track">
      <img class="art-clouds-tile" src={cloudsBackground} alt="" />
      <img class="art-clouds-tile" src={cloudsBackground} alt="" />
    </div>
  </div>

  <div class="art-island art-island-top" aria-hidden="true">
    <div class="art-island-inner parallax-inner">
      {topImageLoading ? (
        <div class="art-island-reveal">
          <img class="art-island-reveal-final" src={topImage} alt="" />
          <img class="art-island-reveal-loading" src={topImageLoading} alt="" />
        </div>
      ) : (
        <img src={topImage} alt="" />
      )}
    </div>
  </div>

  <div class="content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p class="body-text">{text}</p>
  </div>

  <div class="art-island art-island-bottom" aria-hidden="true">
    <div class="art-island-inner parallax-inner">
      {bottomImageLoading ? (
        <div class="art-island-reveal">
          <img class="art-island-reveal-final" src={bottomImage} alt="" />
          <img class="art-island-reveal-loading" src={bottomImageLoading} alt="" />
        </div>
      ) : (
        <img src={bottomImage} alt="" />
      )}
    </div>
  </div>
</section>

<script>
  // Proximity-repel drift for every `.parallax-inner` element on the page
  // (both islands here, and reused automatically if this component is
  // used more than once). One mousemove listener + one rAF loop drive
  // all of them, each easing toward its own target offset.
  //
  // Unlike a simple "follow the cursor" tilt, the target here points
  // AWAY from the cursor: each island measures the vector from the
  // pointer to its own untransformed rest position, and drifts along
  // that vector. The push strength falls off linearly with distance and
  // is zero past `influenceRadius`, so far-away islands just sit still.
  const islands = document.querySelectorAll<HTMLElement>(".parallax-inner");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (islands.length && !prefersReducedMotion) {
    const maxOffset = 36; // px, strongest push when cursor is right on top of the island
    const influenceRadius = 500; // px, push fades to 0 beyond this distance
    const ease = 0.08;

    let mouseX = 0;
    let mouseY = 0;
    let hasMouse = false;

    const state = Array.from(islands).map((el) => ({
      el,
      currentX: 0,
      currentY: 0,
    }));

    window.addEventListener("mousemove", (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      hasMouse = true;
    });

    function tick() {
      for (const s of state) {
        let targetX = 0;
        let targetY = 0;

        if (hasMouse) {
          // Rest position = current on-screen center minus whatever
          // offset we've already applied, so this stays correct as the
          // page scrolls or the island is mid-drift.
          const rect = s.el.getBoundingClientRect();
          const restX = rect.left + rect.width / 2 - s.currentX;
          const restY = rect.top + rect.height / 2 - s.currentY;

          const dx = restX - mouseX;
          const dy = restY - mouseY;
          const dist = Math.hypot(dx, dy) || 1;

          if (dist < influenceRadius) {
            const falloff = 1 - dist / influenceRadius; // 1 = cursor on top, 0 = at the edge
            const nx = dx / dist;
            const ny = dy / dist;
            targetX = nx * maxOffset * falloff;
            targetY = ny * maxOffset * falloff;
          }
        }

        s.currentX += (targetX - s.currentX) * ease;
        s.currentY += (targetY - s.currentY) * ease;
        s.el.style.transform = `translate(${s.currentX.toFixed(2)}px, ${s.currentY.toFixed(2)}px)`;
      }
      requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }

  // Wireframe <-> final-artwork reveal for either island's optional
  // loading image (see `.art-island-reveal` in the <style> below).
  // There can be up to two `.art-island-reveal` elements now (top
  // island, bottom island, depending on which `...Loading` props were
  // passed in) — everything below operates per-element via a loop, so
  // the two islands are fully independent of each other.
  //
  // Two distinct triggers share the same underlying animation classes
  // (`is-materializing` / `is-dematerializing`, see the <style>
  // below):
  //
  //   1. Entrance (`watchEntrance`): one-time, timer-driven, fires the
  //      first time the island is FULLY within the viewport (see
  //      `threshold: 1.0` below). Plays materialize,
  //      waits for it to finish, then plays dematerialize while
  //      permanently marking the final artwork visible (`is-revealed`)
  //      — this is the original "loading -> real image" reveal.
  //   2. Hover (`watchHoverReveal`): repeatable, cursor-driven, starts
  //      only once the entrance sequence above has fully settled.
  //      Materialize plays for as long as the cursor is over the
  //      island's artwork; the moment it leaves, dematerialize plays.
  //      Since `is-revealed` is already permanently set by this point,
  //      the final artwork never actually disappears underneath — the
  //      wireframe is just sweeping in and out on top of it.
  //
  // Detection for the hover watcher is a point-in-rect check against a
  // shared mousemove position, not real `:hover`/`mouseenter` —
  // `.art-island` is `pointer-events: none` (this is decorative
  // background art, not meant to intercept clicks), so native hover
  // events never fire on it. Same proximity-watcher approach as
  // AchievementIslandSection.astro's glitch effects.
  const reveals = document.querySelectorAll<HTMLElement>(".art-island-reveal");

  if (reveals.length && !prefersReducedMotion) {
    const materializeDuration = 1200; // ms — keep in sync with the `materialize` animation's duration in the <style> below
    const dematerializeDuration = 900; // ms — keep in sync with the `dematerialize` animation's duration in the <style> below

    let hoverX = -Infinity;
    let hoverY = -Infinity;
    window.addEventListener("mousemove", (e) => {
      hoverX = e.clientX;
      hoverY = e.clientY;
    });

    function playMaterialize(reveal: HTMLElement) {
      reveal.classList.remove("is-dematerializing");
      reveal.classList.add("is-materializing");
    }

    function playDematerialize(reveal: HTMLElement) {
      reveal.classList.remove("is-materializing");
      reveal.classList.add("is-dematerializing");
    }

    function watchEntrance(reveal: HTMLElement, onSettled: () => void) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;

            playMaterialize(reveal);
            // Phase 2 starts once phase 1's animation has actually
            // finished playing, not before — a plain `setTimeout`
            // matching the animation's own duration is simpler and
            // more robust here than juggling `animationend` across
            // the multiple properties phase 1 animates.
            setTimeout(() => {
              // `is-revealed` is permanent from here on — the final
              // artwork stays at opacity 1 forever after, regardless
              // of whatever the wireframe does next (including every
              // future hover cycle).
              reveal.classList.add("is-revealed");
              playDematerialize(reveal);

              setTimeout(() => {
                // Entrance is fully done. `onSettled` hands control
                // over to the hover watcher below — nothing here
                // leaves the loading image `display: none`d anymore
                // (it used to), since hovering needs to keep reusing
                // it indefinitely.
                onSettled();
              }, dematerializeDuration);
            }, materializeDuration);

            observer.disconnect();
          }
        },
        // `threshold: 1.0` — `entry.isIntersecting` only turns true
        // once the element's intersection ratio reaches 1.0, i.e. the
        // entire island is inside the viewport, not just part of it.
        //
        // `rootMargin` expands the viewport horizontally (by a value
        // far bigger than these islands ever intentionally bleed off
        // the left/right edge — see the top-of-file comment on that
        // sizing) so that deliberate horizontal overflow never counts
        // against the ratio. Without this, an island that's designed
        // to poke past the screen edge at narrower viewports could
        // never reach ratio 1.0 at all, and its entrance would never
        // fire. Left unexpanded top/bottom, so what actually gates the
        // reveal is exactly what you asked for: the island fully
        // visible top-to-bottom as you scroll.
        { threshold: 1.0, rootMargin: "0px 2000px 0px 2000px" }
      );

      observer.observe(reveal);
    }

    function watchHoverReveal(reveal: HTMLElement) {
      let hovering = false;

      function poll() {
        const rect = reveal.getBoundingClientRect();
        const isOver =
          hoverX >= rect.left &&
          hoverX <= rect.right &&
          hoverY >= rect.top &&
          hoverY <= rect.bottom;

        if (isOver && !hovering) {
          hovering = true;
          playMaterialize(reveal);
        } else if (!isOver && hovering) {
          hovering = false;
          playDematerialize(reveal);
        }

        requestAnimationFrame(poll);
      }

      requestAnimationFrame(poll);
    }

    reveals.forEach((reveal) => {
      watchEntrance(reveal, () => watchHoverReveal(reveal));
    });
  }
</script>

<style>
  .art-section {
    position: relative;
    /* Explicit (not `auto`) so this section establishes its OWN local
       stacking context — needed so its `.art-clouds-bg` (z-index: -2)
       can win against EducationIslandSection's own flat fallback
       background-color in their overlap zone, instead of that
       negative z-index escaping to the page root and structurally
       losing to ANY z-index:auto positioned box on the page,
       Education's included. See the top-of-file comment ("Follow-up
       bug" / "Root cause, precisely" / "Fix") for the full reasoning
       — short version: without this, raising `.art-clouds-bg` higher
       had zero visible effect no matter the number. */
    z-index: 0;
    min-height: 100vh;
    /* `aspect-ratio: 16 / 9` matches the moon background image
