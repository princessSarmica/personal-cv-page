---
// src/components/Section.astro
//
// Plain content section: eyebrow + title + text, on a white page.
// No artwork, no animation -- the layout is intentionally bare so each
// island can be redesigned from scratch.
//
// `text` is trusted, hand-written HTML from src/i18n/ui.ts (bullet
// lists and links), so it is rendered with `set:html`.
//
// `class` lets a section keep the class name the nav menu
// (IslandNavMenu.astro) uses to find it, e.g. "education-section".
// The nav scrolls to the `.content` element inside each section.

interface Props {
  id: string;
  class?: string;
  eyebrow?: string;
  title: string;
  text: string;
}

const { id, class: className, eyebrow, title, text } = Astro.props;
---

<section class:list={["site-section", className]} id={id}>
  <div class="content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <div class="body-text" set:html={text} />
  </div>
</section>

<style>
  .site-section {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 6vw, 6rem);
  }

  .content {
    max-width: 44rem;
    width: 100%;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555;
    margin: 0 0 0.75rem;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    margin: 0 0 1rem;
    color: #1a1a1a;
  }

  .body-text {
    font-size: 1.05rem;
    color: #333;
  }

  .body-text :global(ul) {
    margin: 0;
    padding-left: 1.25rem;
  }

  .body-text :global(li) {
    margin: 0.4rem 0;
  }

  .body-text :global(a) {
    color: inherit;
  }
</style>
