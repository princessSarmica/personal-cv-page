---
// src/components/Section.astro
//
// Plain content section: eyebrow + title + text. No illustration or
// animation yet — that comes later once the drawings + GSAP pass happens.
//
// An empty `.illustration` div is already reserved in the markup/CSS so
// that adding the artwork later is just filling in this slot, not
// restructuring the layout.
//
// Usage:
//   <Section
//     id="section-1"
//     eyebrow="Island 01"
//     title="Lorem Ipsum Dolor"
//     text="Lorem ipsum dolor sit amet..."
//   />

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  text: string;
}

const { id, eyebrow, title, text } = Astro.props;
---

<section class="site-section" id={id}>
  <div class="content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p class="body-text">{text}</p>
  </div>

  <!-- Reserved for the section's illustration, added later -->
  <div class="illustration" aria-hidden="true"></div>
</section>

<style>
  .site-section {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 6vw, 6rem);
  }

  .content {
    position: relative;
    z-index: 2;
    max-width: 34rem;
    margin: 0 auto;
    text-align: center;
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555;
    margin: 0 0 0.75rem;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    margin: 0 0 1rem;
    color: #1a1a1a;
  }

  .body-text {
    font-size: 1.05rem;
    color: #444;
    max-width: 32ch;
    margin: 0 auto;
  }

  .illustration {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* full-section backdrop placeholder — later this is where the
       section's illustration sits behind the centered text.
       The persistent bottom-left "you sitting on an island" piece
       is separate and should live as a fixed element in Layout.astro,
       not here. */
    border: 1px dashed #ccc;
    border-radius: 8px;
    margin: 1rem;
  }
</style>