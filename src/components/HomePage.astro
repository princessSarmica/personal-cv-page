---
// src/components/HomePage.astro
//
// Shared page body for every locale (src/pages/index.astro, /de/, /sl/).
// Currently a plain white page: each section is just its text from
// src/i18n/ui.ts, with no artwork. Section `class` names are what
// IslandNavMenu.astro scrolls to, so keep them in sync with that file.

import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import IntroSection from './IntroSection.astro';
import Section from './Section.astro';
import EducationSection from './EducationSection.astro';

const t = useTranslations(Astro.currentLocale);
---

<Layout title={t("nav.title")}>
  <IntroSection
    id="section-intro"
    name={t("intro.name")}
    titles={t("intro.titles")}
    contact={t("intro.contact")}
  />

  <EducationSection
    id="section-cs"
    class="education-section"
    eyebrow={t("education.eyebrow")}
    title={t("education.title")}
    text={t("education.text")}
  />

  <Section
    id="section-1"
    class="art-section"
    eyebrow={t("art.eyebrow")}
    title={t("art.title")}
    text={t("art.text")}
  />

  <Section
    id="section-computer"
    class="computer-section"
    eyebrow={t("computer.eyebrow")}
    title={t("computer.title")}
    text={t("computer.text")}
  />

  <Section
    id="section-achievements"
    class="achievement-section"
    eyebrow={t("achievement.eyebrow")}
    title={t("achievement.title")}
    text={t("achievement.text")}
  />

  <Section
    id="section-hobbies"
    class="hobby-section"
    eyebrow={t("hobby.eyebrow")}
    title={t("hobby.title")}
    text={t("hobby.text")}
  />

  <Section
    id="section-bonus"
    class="bonus-section"
    eyebrow={t("bonus.eyebrow")}
    title={t("bonus.title")}
    text={t("bonus.text")}
  />
</Layout>
