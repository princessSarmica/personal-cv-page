---

import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import IntroIslandSection from './IntroIslandSection.astro';
import InBetweenSection1 from './InBetweenSection1.astro';
import ArtIslandSection from './ArtIslandSection.astro';
import ComputerIslandSection from './ComputerIslandSection.astro';
import EducationIslandSection from './EducationIslandSection.astro';
import AchievementIslandSection from './AchievementIslandSection.astro';
import HobbyIslandSection from './HobbyIslandSection.astro';
import BonusIslandSection from './BonusIslandSection.astro';
import OtherIslandSection from './OtherIslandSection.astro';

// New: every content image in the project now flows through Astro's
// asset pipeline (astro:assets) instead of being a plain public/
// URL string. Importing each file here (from src/images/, not
// public/images/) hands Astro the actual file at build time, so it
// can read real dimensions and — for the section components that
// were updated to render <Image /> instead of a raw <img> — actually
// resize/reformat the output. Each import below is handed to the
// matching section as a prop; the section components' own top-of-
// file comments explain what each prop does with it.

// computer_island.gif is the one exception: Astro's built-in image
// service can't process animated GIFs (see ComputerIslandSection's
// own comment on `rightImage`), so it's still imported here (to get
// it into the build via src/, hashed like everything else) but
// rendered with a plain <img> further down the tree, not <Image />.

import inBetween1BackgroundImage from '../images/in_between_section_background_1.webp';
import educationImage from '../images/education_island_background_ver3_small.webp';
import educationCloudsBackground from '../images/education_island_clouds_background_original_backup.webp';
import educationGlitchSq1Frame1 from '../images/glitch_gray_sq1_1.webp';
import educationGlitchSq1Frame2 from '../images/glitch_gray_sq1_2.webp';
import educationGlitchSq1Frame3 from '../images/glitch_gray_sq1_3.webp';
import educationGlitchSq2Frame1 from '../images/glitch_gray_sq2_1.webp';
import educationGlitchSq2Frame2 from '../images/glitch_gray_sq2_2.webp';
import educationGlitchSq2Frame3 from '../images/glitch_gray_sq2_3.webp';
import artTopImage from '../images/left_top_art_island.webp';
import artTopImageLoading from '../images/left_top_art_island_loading_ver2.webp';
import artBottomImage from '../images/right_bottom_art_island.webp';
import artBottomImageLoading from '../images/right_bottom_art_island_loading_ver2.webp';
import artMoonBackground from '../images/art_island_moon_background.webp';
import artCloudsBackground from '../images/art_island_clouds_background.webp';
import computerLeftImage from '../images/left_powerline_island.webp';
import computerRightImage from '../images/computer_island.gif';
import computerCloudsBackground from '../images/computer_island_background_ver2.webp';
import achievementLeftImage from '../images/left_achievement_island.webp';
import achievementLeftImageGlitched from '../images/left_achievement_island_glitched.webp';
import achievementBackgroundImage from '../images/achievement_island_background_ver3.webp';
import achievementCloudsBackground from '../images/achievement_island_background_clouds.webp';
import hobbyBackIslandImage from '../images/hobby_back_island.webp';
import hobbyFrontIslandImage from '../images/hobby_front_island.webp';
import hobbyJoyconImage from '../images/joycon.webp';
import hobbyBackgroundImage from '../images/hobby_island_background.webp';
import hobbyBackIslandFrozenImage from '../images/hobby_back_island_frozen.webp';
import hobbyPalmTreeImage from '../images/palm_tree.webp';
import hobbyPalmTree80sImage from '../images/palm_tree_80s.webp';
import hobbyMonadoImage from '../images/monado.webp';
import hobbyMonadoSymbol1Image from '../images/monado_symbol_1.webp';
import hobbyMonadoSymbol2Image from '../images/monado_symbol_2.webp';
import hobbyMonadoSymbol3Image from '../images/monado_symbol_3.webp';
import hobbyMonadoSymbol4Image from '../images/monado_symbol_4.webp';
import hobbyMonadoSymbol5Image from '../images/monado_symbol_5.webp';
import hobbyFountainImage from '../images/fountain.webp';
import bonusBackgroundImage from '../images/bonus_island_background.webp';
import bonusCloudsBackground from '../images/bonus_island_background_clouds.webp';
import otherImage from '../images/other_island_2.webp';
import otherMobileImage from '../images/other_island.webp';

// Astro.currentLocale is computed from the current URL according to
// the `i18n` config in astro.config.mjs (e.g. "/de/" -> "de"); it's
// undefined on routes i18n doesn't recognize, so `useTranslations`
// falls back to the default language in that case.

const t = useTranslations(Astro.currentLocale);

---

<Layout title={t("nav.title")}>
  <IntroIslandSection
    id="section-intro"
    name={t("intro.name")}
    titles={t("intro.titles")}
  />

  <InBetweenSection1
    id="section-in-between-1"
    backgroundImage={inBetween1BackgroundImage}
  />

  <EducationIslandSection
    id="section-cs"
    eyebrow={t("education.eyebrow")}
    title={t("education.title")}
    text={t("education.text")}
    image={educationImage}
    cloudsBackground={educationCloudsBackground}
    glitchSquare1Frame1={educationGlitchSq1Frame1}
    glitchSquare1Frame2={educationGlitchSq1Frame2}
    glitchSquare1Frame3={educationGlitchSq1Frame3}
    glitchSquare2Frame1={educationGlitchSq2Frame1}
    glitchSquare2Frame2={educationGlitchSq2Frame2}
    glitchSquare2Frame3={educationGlitchSq2Frame3}
  />





  <ArtIslandSection


    id="section-1"


    eyebrow={t("art.eyebrow")}


    title={t("art.title")}


    text={t("art.text")}


    topImage={artTopImage}


    topImageLoading={artTopImageLoading}


    bottomImage={artBottomImage}


    bottomImageLoading={artBottomImageLoading}


    moonBackground={artMoonBackground}


    cloudsBackground={artCloudsBackground}


  />





  <ComputerIslandSection


    id="section-cs"


    eyebrow={t("computer.eyebrow")}


    title={t("computer.title")}


    text={t("computer.text")}


    leftImage={computerLeftImage}


    rightImage={computerRightImage}


    cloudsBackground={computerCloudsBackground}


  />





  <AchievementIslandSection


    id="section-achievements"


    eyebrow={t("achievement.eyebrow")}


    title={t("achievement.title")}


    text={t("achievement.text")}


    leftImage={achievementLeftImage}


    leftImageGlitched={achievementLeftImageGlitched}


    backgroundImage={achievementBackgroundImage}


    cloudsBackground={achievementCloudsBackground}


  />





  <HobbyIslandSection


    id="section-hobbies"


    eyebrow={t("hobby.eyebrow")}


    title={t("hobby.title")}


    text={t("hobby.text")}


    backIslandImage={hobbyBackIslandImage}


    frontIslandImage={hobbyFrontIslandImage}


    joyconImage={hobbyJoyconImage}


    backgroundImage={hobbyBackgroundImage}


    backIslandFrozenImage={hobbyBackIslandFrozenImage}


    palmTreeImage={hobbyPalmTreeImage}


    palmTree80sImage={hobbyPalmTree80sImage}


    monadoImage={hobbyMonadoImage}


    monadoSymbolImages={[


      hobbyMonadoSymbol1Image,


      hobbyMonadoSymbol2Image,


      hobbyMonadoSymbol3Image,


      hobbyMonadoSymbol4Image,


      hobbyMonadoSymbol5Image,


    ]}


    fountainImage={hobbyFountainImage}


  />





  <BonusIslandSection


    id="section-bonus"


    eyebrow={t("bonus.eyebrow")}


    title={t("bonus.title")}


    text={t("bonus.text")}


    backgroundImage={bonusBackgroundImage}


    cloudsBackground={bonusCloudsBackground}


  />





  <OtherIslandSection


    id="section-closing"


    image={otherImage}


    mobileImage={otherMobileImage}


  />


</Layout>