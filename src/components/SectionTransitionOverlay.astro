---
// src/components/SectionTransitionOverlay.astro
//
// A full-viewport "whip pan" transition image, per your request: a
// fast cartoon-style camera-swipe -- like the "camera" whipping
// between two places in a cartoon -- that plays over every nav-menu
// section jump (see IslandNavMenu.astro) so the jump reads as a
// deliberate whoosh instead of an abrupt cut. Rendered once here in
// Layout.astro (same convention as GitHubLink.astro / IslandNavMenu.astro:
// a single persistent element that survives every section and every
// language switch via <ClientRouter />, rather than being duplicated
// per-section).
//
// How this talks to IslandNavMenu.astro: this component owns the
// overlay image and its CSS animation; IslandNavMenu.astro owns the
// scroll jump. Neither imports the other -- they're wired together
// with two DOM CustomEvents instead, so each stays a self-contained,
// single-purpose component (same spirit as the `body:has(.class:hover)`
// cross-component pattern already used for the cursor-spotlight in
// Layout.astro, just event-based here since this needs to run JS at a
// specific MOMENT, not just toggle a style):
//
//   - "section-transition:trigger" -- dispatched BY IslandNavMenu.astro
//     on every nav-menu click, asking this component to play the
//     whip-pan animation. Carries `detail: { direction: 1 | -1 }`
//     (1 = jumping down the page, -1 = jumping up it -- the same
//     sign IslandNavMenu also uses for its own pre-whip nudge, so
//     both halves of the motion always agree on which way things
//     are moving): the whip plays bottom-to-top for a downward
//     jump, or the mirror image -- top-to-bottom -- for an upward
//     one, so the sweep always reads as continuing whichever way
//     the page was already heading rather than always playing the
//     same direction regardless.
//   - "section-transition:midpoint" -- dispatched BY this component,
//     the instant the overlay is fully covering the viewport (halfway
//     through the animation, see the keyframes below). IslandNavMenu
//     listens for this once and performs the actual (now instant, see
//     its own comment) scroll jump at that exact moment -- hidden
//     behind the overlay, so nobody sees the jump itself, only the
//     whoosh.
//
// `loading="eager"` (not this project's usual lazy default -- see
// every other section's own note on that) is required here, not just
// a nice-to-have: a "fast transition" effect that itself has to fetch
// on first use would show a blank flash on the very FIRST nav click
// instead of the intended image, defeating the whole point. Eager-
// loading it as part of the initial page load means it's already
// decoded and cached long before anyone can click the nav menu.
import { Image } from 'astro:assets';
import loadingJumpImage from '../images/loading_jump.webp';
---

<Image
  class="section-transition-overlay"
  src={loadingJumpImage}
  alt=""
  aria-hidden="true"
  loading="eager"
  decoding="async"
/>

<script>
  // Wrapped in `astro:page-load` (not run at the top level) for the
  // same reason every other per-component script in this project is:
  // a language switch swaps in a freshly-parsed copy of this
  // component's markup without ever re-running a top-level script.
  // `cleanupTransitionOverlay` tears down the previous navigation's
  // listener before attaching a new one, so switching languages back
  // and forth all session never piles up duplicates.
  let cleanupTransitionOverlay: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    cleanupTransitionOverlay?.();

    const overlay = document.querySelector<HTMLImageElement>(
      ".section-transition-overlay"
    );
    if (!overlay) return;

    const controller = new AbortController();
    const { signal } = controller;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    // Three explicit phases, each a separate CSS animation swapped in
    // by this script (not one continuous 0%/50%/100% keyframe block
    // like an earlier version of this used) -- per your report that
    // the transition on phones would finish its sweep and reveal the
    // destination section before that section had actually finished
    // scrolling/painting into place, leaving a stale frame of the OLD
    // section visible for a moment before it finally snapped over:
    //
    //   1. COVER (ENTER_MS) -- the whip sweeps in from off-screen to
    //      fully covering the viewport. Matches `section-whip-cover`
    //      below exactly.
    //   2. HOLD (HOLD_MS) -- the whip stays fully covering the screen,
    //      not animating at all (no keyframes running -- just sitting
    //      at the position COVER finished at, via that animation's own
    //      `forwards` fill mode). This is the actual fix: the old
    //      version had no real hold at all, just the single instant
    //      the 0%/50%/100% keyframes happened to pass through "fully
    //      covered" on their way from entering to exiting -- on a slow
    //      phone, painting the destination section (images decoding,
    //      every section's own always-on bob/drift/sparkle CSS loops
    //      starting up, etc.) can take noticeably longer than that
    //      single instant, so the whip would already be uncovering
    //      the page again before the destination was actually ready,
    //      showing the stale OLD section peeking through underneath.
    //      HOLD_MS is dead time bought specifically to cover that.
    //   3. EXIT (EXIT_MS) -- the whip continues on to fully off-screen
    //      the other side. Matches `section-whip-exit` below exactly.
    //
    // The actual scroll jump (IslandNavMenu.astro's listener on
    // "section-transition:midpoint") happens the INSTANT phase 1
    // ends and phase 2's hold begins -- i.e. as early as possible
    // while still fully hidden -- so the whole of HOLD_MS plus all of
    // EXIT_MS is buffer time before anyone could see anything, not
    // just a fraction of it.
    //
    // All three numbers must match their CSS `animation-duration`
    // counterparts below exactly, the same reason the old single
    // DURATION_MS had to match its own CSS -- this script has no
    // other way to know when a CSS-driven animation phase ends.
    // ENTER_MS trimmed from 300 to 200, per your report that when the
    // page is struggling to finish loading/decoding a section's
    // assets, having this whip cover the screen SOONER helps hide
    // that stutter -- the sooner COVER finishes, the sooner
    // `section-transition:midpoint` fires below and the sooner the
    // (still fully hidden) destination section gets its scroll jump
    // and starts painting behind the now-opaque overlay, buying it
    // more of HOLD_MS to actually finish before EXIT reveals it.
    // HOLD_MS/EXIT_MS left as-is -- only how fast the cover itself
    // arrives was the ask.
    const ENTER_MS = 200;
    const HOLD_MS = 350;
    const EXIT_MS = 300;

    // Tracks this component's own in-flight phase timers so a rapid
    // repeat nav click (a fresh "trigger" event arriving before the
    // previous whip finished its full cover-hold-exit sequence) can
    // clear them before scheduling its own -- otherwise the OLD
    // click's stale timers would still fire later, e.g. yanking
    // `.is-covering`/`.is-exiting` off mid-way through the NEW click's
    // own animation. IslandNavMenu.astro cancels its own scroll-jump
    // side (via its per-click AbortController), but it doesn't know
    // about this component's internal timers, so this needs its own
    // bookkeeping.
    let pendingTimeouts: number[] = [];
    const clearPendingTimeouts = () => {
      pendingTimeouts.forEach((id) => window.clearTimeout(id));
      pendingTimeouts = [];
    };

    document.addEventListener(
      "section-transition:trigger",
      (event) => {
        if (prefersReducedMotion) {
          // The CSS below already hides this overlay entirely under
          // this setting (no animation to play), so just fire the
          // midpoint event immediately -- otherwise IslandNavMenu's
          // jump would sit there waiting forever for an event that
          // never comes.
          document.dispatchEvent(
            new CustomEvent("section-transition:midpoint")
          );
          return;
        }

        // `direction` defaults to 1 (down) if this ever fires without
        // a `detail` (there's currently no such caller, but a plain
        // `dispatchEvent(new Event(...))` from, say, a future caller
        // or a console test shouldn't throw here).
        const direction =
          event instanceof CustomEvent && event.detail?.direction === -1 ? -1 : 1;

        // Cancel whichever phase a previous, still-in-flight whip was
        // in before starting this one -- see `pendingTimeouts` above.
        clearPendingTimeouts();

        // Restart from scratch even if a previous whip is still
        // mid-flight (rapid repeat nav clicks): remove every phase
        // class, force a reflow so the browser forgets any animation
        // ever ran, then re-add the first one -- without the forced
        // reflow, adding the same class back-to-back is a no-op and
        // the animation wouldn't restart. `is-reverse` (see the
        // styles below) is what actually flips the sweep's direction
        // to match.
        overlay.classList.remove("is-covering", "is-exiting", "is-reverse");
        void overlay.offsetWidth;
        if (direction === -1) overlay.classList.add("is-reverse");
        overlay.classList.add("is-covering");

        // Phase 1 -> 2: the instant COVER finishes, the whip is fully
        // covering the screen and just sits there (see the HOLD
        // explanation above) -- this is also the earliest safe moment
        // for the actual scroll jump, so fire it right here.
        pendingTimeouts.push(
          window.setTimeout(() => {
            document.dispatchEvent(
              new CustomEvent("section-transition:midpoint")
            );
          }, ENTER_MS)
        );

        // Phase 2 -> 3: HOLD_MS after that, swap to the EXIT
        // animation. `section-whip-exit`'s own 0% keyframe is
        // `translateY(0%)` -- exactly where COVER's `forwards` fill
        // left the element sitting during the hold -- so this is a
        // seamless continuation, not a jump.
        pendingTimeouts.push(
          window.setTimeout(() => {
            overlay.classList.remove("is-covering");
            overlay.classList.add("is-exiting");
          }, ENTER_MS + HOLD_MS)
        );

        // Phase 3 done: fully off-screen again, clean up both classes.
        pendingTimeouts.push(
          window.setTimeout(() => {
            overlay.classList.remove("is-exiting", "is-reverse");
          }, ENTER_MS + HOLD_MS + EXIT_MS)
        );
      },
      { signal }
    );

    cleanupTransitionOverlay = () => {
      controller.abort();
      clearPendingTimeouts();
    };
  });
</script>

<style>
  .section-transition-overlay {
    /* Fixed + full-viewport, well above every other layer on the page
       (the halftone cursor-spotlight, section content, etc. all sit
       well under 2000) -- this needs to cover literally everything
       while it plays, with two deliberate exceptions, both per your
       requests: CornerIsland.astro's `.corner-island` sits ABOVE this
       (z-index: 10001), and IslandNavMenu/LanguageSwitcher/GitHubLink
       sit above THAT (z-index: 10002) -- so the nav menu, language
       switcher, GitHub link and the corner island all stay visible in
       front of the whip as it sweeps across the screen, instead of
       being covered like the rest of the page. */
    position: fixed;
    /* This image is a REPLACED element, so `inset: 0` on its own
       is not enough to make it fill the viewport: per the CSS sizing
       rules for fixed/absolutely-positioned replaced elements, when
       `width`/`height` are left at their default `auto`, the browser
       falls back to the image's own INTRINSIC pixel size (confirmed
       directly: with only `inset: 0` set, this rendered at exactly
       the source `loading_jump.webp` dimensions instead of the
       viewport) rather than stretching between the four inset edges
       the way an ordinary (non-replaced) box would. `width: 100%` /
       `height: 100%` are what actually force it to fill the
       containing block (the viewport, for a `position: fixed`
       element) regardless of the image's own dimensions; `inset: 0`
       is kept alongside them to pin that box to all four edges. This
       also sidesteps the `100vw`/`100dvh` version used previously,
       whose `dvh` recalculation as mobile browser chrome shows/hides
       is a known trouble spot for FIXED, ANIMATED elements -- `%`
       here resolves against the same fixed-position containing block
       without that dynamic-viewport-unit behavior.

       Follow-up, per your report of a gap of cut-off space at the
       bottom of the screen (the sweep image not quite reaching the
       edge) specifically once the scroll-flick trigger was added:
       `%`/`vh`-based sizing here resolves against the SMALL viewport
       (the shorter measurement, with the browser's address bar still
       showing) on the phones that make this distinction. A fast
       flick is exactly what makes a mobile browser auto-collapse
       that address bar mid-scroll, which hands you back MORE visible
       height than the overlay was sized for an instant earlier --
       precisely the gap you saw, and precisely why it only showed up
       "sometimes" (only alongside a fast flick, not a slow scroll or
       a nav-menu click, where the chrome doesn't move mid-animation).
       `height: 100lvh` (Large Viewport Height -- the viewport's size
       with the browser's UI treated as fully RETRACTED, i.e. the
       biggest it can ever be) fixes this without bringing back the
       `dvh` problem noted above: unlike `dvh`, `lvh` is a STATIC
       value that does not itself re-fire/recalculate as the address
       bar animates in and out mid-scroll, so there's no live-resizing
       containing block for the whip's own `translateY` sweep to
       glitch against -- it's simply always sized generously enough
       to cover the tallest the visible area can ever get, in one
       shot, which happens to slightly overshoot (harmlessly, off the
       bottom edge) on the rarer occasions the address bar is still
       showing. `height: 100%` is kept directly above as the fallback
       for any browser old enough not to understand `lvh` -- an
       unsupported unit makes the whole declaration invalid, which
       CSS ignores outright, silently leaving the plain `%` value
       from the line above still in effect. */
    inset: 0;
    width: 100%;
    height: 100%;
    height: 100lvh;
    z-index: 10000;
    /* `loading_jump.webp` itself has a soft transparent fade baked
       into its own top and bottom edges (checked directly against
       the source file: fully transparent at the very edge, ramping
       up to opaque over roughly the first/last 10% of its height) --
       that's what you were actually seeing peek through as "blinking"
       at the top and bottom, on every screen size, not a sizing or
       object-fit problem (that band is a fixed PROPORTION of the
       image regardless of screen size, so it was always there -- just
       more pixels, and so more noticeable, on a bigger screen, and
       extra obvious now that the whip sits still for a moment during
       the hold instead of always being mid-motion). Neither `cover`
       nor `fill` can fix transparency actually baked into the image
       -- object-fit only ever decides how the image's own pixels map
       onto the box, not what shows through pixels that are see-through
       to begin with. This background-color is what actually fixes it:
       it sits BEHIND the image (a plain `<img>`, so its own
       transparent/semi-transparent pixels let this show through
       directly), sampled as the image's own alpha-weighted average
       color, so the fade blends into more of the same sky-blue
       instead of the real page underneath. */
    background-color: #2edef8;
    /* `object-fit: fill` (changed from `cover`) per your report that
       you were still seeing thin gaps -- the real page blinking
       through -- at the top and bottom of the screen even with the
       box itself now reliably full-viewport (see above): `cover`
       only guarantees no gaps when the box's own size and the
       image's aspect ratio line up exactly on every single frame,
       and on a real phone the box's `%`-based size can still shift
       very slightly as the browser's own address bar shows/hides
       mid-animation -- `cover` would then briefly be scaled for the
       PREVIOUS box size, leaving a sliver uncovered until it catches
       up. `fill` sidesteps that risk entirely: instead of preserving
       the image's own proportions and cropping the overflow, it
       always stretches the image to EXACTLY match the box's current
       width and height, on every frame, no matter what that size is
       -- so there is no aspect-ratio math that can fall out of sync
       with a shifting box, and the image always covers it edge to
       edge with zero gap by construction. The trade-off is that the
       image itself can look slightly squashed or stretched rather
       than perfectly proportioned (no longer cropping the sides on a
       narrow phone or the top/bottom on a wide screen, just scaling
       to fit) -- worth it here since this only shows for a few
       hundred ms during a fast whip-pan sweep, where "zero gaps,
       every time" matters far more than pixel-perfect proportions. */
    object-fit: fill;
    pointer-events: none;

    /* Which way the sweep travels: `--whip-from` is where it enters
       from (and this element's own resting position, parked fully
       out of sight below the viewport, ready for the default
       downward sweep), `--whip-to` is where it exits. `.is-reverse`
       below overrides both for an upward jump -- enter from the top,
       exit the bottom -- so ONE `@keyframes` block (using these two
       variables instead of hardcoded values) serves both directions
       rather than needing a second, near-duplicate keyframes block. */
    --whip-from: 100%;
    --whip-to: -100%;
    transform: translateY(var(--whip-from));
  }

  /* Phase 1 (COVER): sweeps in from `--whip-from` (fully off-screen)
     to fully covering the viewport. `forwards` fill mode below is
     what makes the element actually STAY at `translateY(0%)` once
     this finishes, rather than snapping back to its CSS resting
     position -- that held-in-place moment IS the hold described in
     the script above, not a separate animation of its own. */
  @keyframes section-whip-cover {
    from {
      transform: translateY(var(--whip-from));
    }
    to {
      transform: translateY(0%);
    }
  }

  /* Phase 3 (EXIT): continues on from fully covering (`from` here
     matches exactly where COVER's `forwards` fill left the element)
     to fully off-screen the other side (`--whip-to`). Split from
     COVER into its own animation/class specifically so the script
     above can delay STARTING this one by an arbitrary hold, rather
     than the whole cover-hold-exit sweep being one fixed-duration
     animation with no way to pause partway through. */
  @keyframes section-whip-exit {
    from {
      transform: translateY(0%);
    }
    to {
      transform: translateY(var(--whip-to));
    }
  }

  /* Default (no `.is-reverse`) direction for both phases: bottom to
     top, matching a downward jump -- see `.is-reverse` below for the
     mirrored, upward-jump variant. `200ms`/`300ms` here must match
     ENTER_MS/EXIT_MS in the script above exactly (the hold between
     them, HOLD_MS, is pure JS-side delay -- it has no CSS duration of
     its own, since it's just the element sitting still between the
     two animations). COVER is intentionally quicker than EXIT now --
     see ENTER_MS's own comment above -- getting the screen covered
     sooner matters more here than a leisurely entrance, while EXIT
     (already hidden behind a fully-opaque frame) has nothing left to
     rush. */
  .section-transition-overlay.is-covering {
    animation: section-whip-cover 200ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    will-change: transform;
  }

  .section-transition-overlay.is-exiting {
    animation: section-whip-exit 300ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    will-change: transform;
  }

  /* Reversed sweep for an upward jump: enters from the top
     (`--whip-from: -100%`) and exits the bottom (`--whip-to: 100%`)
     -- the exact mirror of the default, so the whip always continues
     whichever way the page was already moving instead of always
     sweeping the same direction regardless of the jump. Toggled
     alongside `.is-covering` (and kept through the later `.is-exiting`
     hand-off) by the script above, per the `direction` carried on the
     triggering event. */
  .section-transition-overlay.is-reverse {
    --whip-from: -100%;
    --whip-to: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-transition-overlay {
      display: none;
    }
  }
</style>
