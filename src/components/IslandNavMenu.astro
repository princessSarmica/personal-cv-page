---
// src/components/IslandNavMenu.astro
//
// The collapsible section-jump menu you sketched: a single round
// "..." button fixed to the top-left corner, which expands downward
// into a dashed vertical timeline -- one circle+label per section,
// each linking straight to that section. Rendered once in
// Layout.astro (next to LanguageSwitcher, which already owns the
// top-RIGHT corner the same way) so it shows up on every page in
// every locale, not just the homepage.

import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);

// Each entry pairs one of the new icons with the exact eyebrow/title
// translation keys that section already renders with (see
// src/i18n/ui.ts) -- reusing them here, instead of writing separate
// nav-only copy, means this menu's labels can never drift out of
// sync with what the section itself says, in any of the three
// locales, and it's already fully translated for free.
//
// `target` is the CSS class every section's own <section> element
// already carries (the same classes this project's own scroll-
// highlight IntersectionObserver already looks for in each section
// component's <script>), not the `id` prop HomePage.astro passes.
// EducationIslandSection and ComputerIslandSection used to share the
// same id ("section-cs" on both, since fixed -- ComputerIslandSection
// is "section-computer" now) -- classes were the only reliable,
// collision-free way to find each one while that bug was still live,
// and they're kept here rather than switched back to ids now that
// it's fixed, since a class-per-section stays robust against this
// exact class of bug happening again in the future.
const items = [
  { icon: "graduation-cap", eyebrow: t("education.eyebrow"), title: t("education.title"), target: ".education-section" },
  { icon: "palette", eyebrow: t("art.eyebrow"), title: t("art.title"), target: ".art-section" },
  { icon: "code-xml", eyebrow: t("computer.eyebrow"), title: t("computer.title"), target: ".computer-section" },
  { icon: "trophy", eyebrow: t("achievement.eyebrow"), title: t("achievement.title"), target: ".achievement-section" },
  { icon: "gamepad-2", eyebrow: t("hobby.eyebrow"), title: t("hobby.title"), target: ".hobby-section" },
  { icon: "rocket", eyebrow: t("bonus.eyebrow"), title: t("bonus.title"), target: ".bonus-section" },
] as const;

// Hand-drawn inline SVGs in Lucide's own visual style (24x24 source
// grid, 2px round-cap/round-join strokes, filled dots where Lucide's
// originals use them) -- this project has no lucide package
// installed, and the environment this was built in had no network
// path to npm's registry or Lucide's own site to pull the exact
// official files. These are close, faithful recreations of the
// ellipsis / graduation-cap / palette / code-xml / trophy /
// gamepad-2 / rocket icons, not byte-identical exports of them -- if
// you'd like the exact originals later, `npm install lucide-astro`
// from your own machine (it doesn't have this sandbox's network
// restriction) and swap these strings for its <GraduationCap />
// etc. components. Sized here (width/height="20") rather than via
// CSS reaching in from outside: this markup is injected with
// `set:html` below, and (same reason the link/list styling needed
// `:global()` a few requests ago) Astro's scoped styles can't reach
// content injected that way -- baking the size into the SVG itself
// sidesteps needing `:global()` here at all.
const ICONS: Record<string, string> = {
  "ellipsis": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1" fill="currentColor" stroke="none"/></svg>`,
  "graduation-cap": `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>`,
  "palette": `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"/><circle cx="13.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/><circle cx="17.5" cy="10.5" r="0.5" fill="currentColor" stroke="none"/><circle cx="6.5" cy="12.5" r="0.5" fill="currentColor" stroke="none"/><circle cx="8.5" cy="7.5" r="0.5" fill="currentColor" stroke="none"/></svg>`,
  "code-xml": `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>`,
  "trophy": `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>`,
  "gamepad-2": `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="12" x2="10" y2="12"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="15" y1="13" x2="15.01" y2="13"/><line x1="18" y1="11" x2="18.01" y2="11"/><path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.544-.604-6.584-.685-7.258A4 4 0 0 0 17.32 5z"/></svg>`,
  "rocket": `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>`,
};
---

<nav class="island-nav" aria-label={t("nav.menuLabel")}>
  <button
    type="button"
    class="island-nav-toggle"
    aria-expanded="false"
    aria-controls="island-nav-panel"
    aria-label={t("nav.toggleOpen")}
    data-label-open={t("nav.toggleOpen")}
    data-label-close={t("nav.toggleClose")}
  >
    <span class="island-nav-toggle-icon" set:html={ICONS["ellipsis"]} />
  </button>

  <div class="island-nav-expandable" id="island-nav-panel">
    <div class="island-nav-bridge" aria-hidden="true"></div>

    <ul class="island-nav-list">
      {items.map((item) => (
        <li class="island-nav-item">
          <a class="island-nav-link" href="#" data-target={item.target}>
            <span class="island-nav-circle" set:html={ICONS[item.icon]} />
            <span class="island-nav-label">{item.eyebrow} – {item.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  /* Fixed to the top-left corner -- the mirror image of
     LanguageSwitcher's top-right placement, same z-index tier (see
     that component's own comment for why this now sits above
     CornerIsland AND the whip-pan transition overlay). `align-items: flex-start`
     keeps the toggle button and the expandable panel below it
     sharing one left edge, which is what lets the dashed connector
     line (further down) line up with every circle's center using
     one fixed offset instead of per-element measurements. */
  /* `pointer-events: none` here, re-enabled below on just the
     toggle button and each link, fixes a real bug: a flex column
     shrink-wraps to its WIDEST child regardless of that child's own
     height, so `.island-nav`'s own box was always as wide as the
     collapsed panel's natural content (e.g. the "Bonus -- Other
     Skills..." label) even while collapsed to 0 height -- nothing
     was ever painted in that extra width, but the invisible box was
     still there and, being later in the DOM than LanguageSwitcher,
     painted (and hit-tested) on top of it wherever the two
     overlapped. That never showed up at desktop widths, where the
     two fixed corners sit far apart, but on a narrow/mobile viewport
     the language pills sit close enough to the left edge to fall
     inside this invisible box and silently eat their clicks. Scoping
     pointer-events back to `auto` on only the two actually-visible,
     actually-interactive pieces (the toggle button, each section
     link) means the rest of this element's box -- however wide it
     happens to be -- never intercepts anything again. */
  .island-nav {
    --island-circle: 2.5rem;
    --island-list-pad: 1rem;

    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    /* Bumped from 1000 to 10002 per your request: this needs to sit
       above BOTH CornerIsland.astro's `.corner-island` (z-index:
       10001 -- previously higher than this, which is what let it
       paint over the nav menu whenever the two got close together)
       and SectionTransitionOverlay.astro's whip-pan image (z-index:
       10000), so the nav menu stays visible and clickable in front
       of everything else on the page at all times, including while
       the whip-pan is mid-sweep -- not just tied with
       LanguageSwitcher/GitHubLink at the old 1000 tier, which sat
       well UNDER the whip and would vanish under it. See those two
       components' own comments for the matching tier. */
    z-index: 10002;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    font-family: ui-sans-serif, system-ui, sans-serif;

    pointer-events: none;
  }

  /* Same reasoning as LanguageSwitcher's own mobile override: a
     2.5rem (40px) circle is close to but still under the ~44px
     touch target both Apple's and Google's guidelines call for, and
     a fingertip is much wider than a mouse cursor. Bumping just the
     custom property grows the toggle button, every item circle, and
     (via the `calc()` uses below) keeps the dashed connector line
     centered under all of them automatically. */
  @media (max-width: 640px) {
    .island-nav {
      --island-circle: 2.75rem;
    }

    .island-nav-list {
      gap: 1.15rem;
    }
  }

  .island-nav-toggle-icon {
    display: flex;
  }

  .island-nav-toggle {
    all: unset;
    box-sizing: border-box;
    pointer-events: auto;

    width: var(--island-circle);
    height: var(--island-circle);
    margin-left: var(--island-list-pad);
    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;
    border: 2px solid #1a1a1a;
    background: rgba(255, 255, 255, 0.85);
    color: #1a1a1a;

    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .island-nav-toggle:hover,
  .island-nav-toggle:focus-visible {
    background: #1a1a1a;
    color: #ffffff;
  }

  /* Collapsed by default (`max-height: 0` + `overflow: hidden`); the
     script below toggles `.is-open` on `.island-nav` on click, which
     is what this rule reacts to. `max-height` (rather than `height`,
     which can't transition to/from `auto`) needs a ceiling well above
     any real content height -- 40rem comfortably clears six items
     even if every label wraps to two lines on a narrow screen. */
  .island-nav-expandable {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.4s ease, opacity 0.3s ease;
  }

  .island-nav.is-open .island-nav-expandable {
    max-height: 40rem;
    opacity: 1;
  }

  /* Short dashed stub bridging the toggle button's own circle down
     into the list's connector line below, so the timeline reads as
     one continuous line starting at the "..." button rather than two
     separate pieces. Same centering trick as the list's own connector
     (`left` at the shared circle-center offset, `translateX(-50%)`
     on a zero-width bordered box) so it lines up automatically. */
  .island-nav-bridge {
    position: relative;
    height: 0.75rem;
  }

  .island-nav-bridge::before {
    content: "";
    position: absolute;
    left: calc(var(--island-list-pad) + var(--island-circle) / 2);
    top: 0;
    bottom: 0;
    width: 3px;
    background-image: repeating-linear-gradient(
      to bottom,
      #1a1a1a 0,
      #1a1a1a 6px,
      transparent 6px,
      transparent 12px
    );
    transform: translateX(-50%);
  }

  .island-nav-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1rem 0.75rem var(--island-list-pad);

    display: flex;
    flex-direction: column;
    gap: 1rem;

    position: relative;

    background: rgba(255, 255, 255, 0.92);
    border-radius: 1.25rem;
  }

  /* The connector line itself, running from the first circle's
     vertical center to the last one's. `top`/`bottom` both use the
     same 1.25rem (half of the 2.5rem circle) since every item's icon
     sits at a fixed offset from ITS OWN top -- this only drifts by a
     few pixels at the very last icon if that item's label happens to
     wrap onto a second line on a narrow screen, which reads as the
     dashed line ending just short of/past the last circle rather than
     anything visually broken. */
  .island-nav-list::before {
    content: "";
    position: absolute;
    left: calc(var(--island-list-pad) + var(--island-circle) / 2);
    top: calc(var(--island-circle) / 2);
    bottom: calc(var(--island-circle) / 2);
    width: 3px;
    background-image: repeating-linear-gradient(
      to bottom,
      #1a1a1a 0,
      #1a1a1a 6px,
      transparent 6px,
      transparent 12px
    );
    transform: translateX(-50%);
    z-index: 0;
  }

  .island-nav-item {
    position: relative;
    z-index: 1;
  }

  .island-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;

    text-decoration: none;
    color: #1a1a1a;

    pointer-events: auto;
  }

  .island-nav-circle {
    flex-shrink: 0;

    width: var(--island-circle);
    height: var(--island-circle);

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;
    border: 2px solid #1a1a1a;
    background: #ffffff;
    color: #1a1a1a;

    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .island-nav-link:hover .island-nav-circle,
  .island-nav-link:focus-visible .island-nav-circle {
    background: #1a1a1a;
    color: #ffffff;
  }

  .island-nav-label {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    max-width: 12rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .island-nav-expandable {
      transition: none;
    }

    .island-nav-toggle,
    .island-nav-circle {
      transition: none;
    }
  }
</style>

<script>
  // Expand/collapse + click-to-scroll behavior for the menu above.
  // Wrapped in `astro:page-load` (not run at the top level) for the
  // same reason every other per-component script in this project is:
  // a language switch via <ClientRouter /> swaps in a freshly-parsed
  // copy of this component's markup without ever re-running a
  // top-level script, so without re-initializing here on every
  // navigation the menu would go dead after the very first language
  // switch. `cleanupIslandNav` tears down the previous navigation's
  // listeners (all attached through one shared AbortController)
  // before attaching new ones, so switching languages back and forth
  // all session never piles up duplicate listeners.
  let cleanupIslandNav: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    cleanupIslandNav?.();

    const nav = document.querySelector<HTMLElement>(".island-nav");
    const toggle = nav?.querySelector<HTMLButtonElement>(".island-nav-toggle");
    const links = nav?.querySelectorAll<HTMLAnchorElement>(".island-nav-link");

    if (!nav || !toggle || !links) return;

    const controller = new AbortController();
    const { signal } = controller;

    // Whether to skip the animated scroll below in favor of landing
    // instantly -- prefers-reduced-motion means "skip animated
    // scrolling in general", not just this project's own decorative
    // animation loops, so a nav-menu click respects it too.
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const openLabel = toggle.dataset.labelOpen ?? "";
    const closeLabel = toggle.dataset.labelClose ?? "";

    const setOpen = (open: boolean) => {
      nav.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? closeLabel : openLabel);
    };

    toggle.addEventListener(
      "click",
      () => setOpen(!nav.classList.contains("is-open")),
      { signal }
    );

    links.forEach((link) => {
      link.addEventListener(
        "click",
        (event) => {
          event.preventDefault();
          const targetSelector = link.dataset.target;
          const section = targetSelector ? document.querySelector(targetSelector) : null;
          // Scroll to the section's own `.content` block (the eyebrow
          // + title + body-text group) rather than the `<section>`
          // itself: every section is a full illustration with the
          // text overlaid somewhere inside it, not filled edge-to-edge
          // with text, so centering the outer `<section>` in the
          // viewport doesn't put what you actually came here to read
          // anywhere near the middle of the screen. `.content` is
          // that text group in all six section components -- falling
          // back to `section` itself just in case a future section
          // doesn't have one, so a menu click still goes somewhere.
          const targetEl = section?.querySelector(".content") ?? section;
          setOpen(false);

          // Straight to the target -- no whip-pan cover, no
          // preparatory nudge -- per your request, a nav-menu click
          // just scrolls to the section it points at. `instant` under
          // prefers-reduced-motion, `smooth` otherwise, leaning
          // entirely on the browser's own native scroll animation
          // rather than anything hand-driven.
          targetEl?.scrollIntoView({
            behavior: prefersReducedMotion ? "instant" : "smooth",
            block: "center",
          });
        },
        { signal }
      );
    });

    // Closing on an outside click and on Escape are small additions
    // beyond what was asked for -- standard behavior for this kind of
    // expanding menu, so it doesn't stay stuck open over the page
    // once you've clicked (or tapped) away from it.
    document.addEventListener(
      "click",
      (event) => {
        if (!nav.classList.contains("is-open")) return;
        if (event.target instanceof Node && nav.contains(event.target)) return;
        setOpen(false);
      },
      { signal }
    );

    nav.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && nav.classList.contains("is-open")) {
          setOpen(false);
          toggle.focus();
        }
      },
      { signal }
    );

    cleanupIslandNav = () => {
      controller.abort();
    };
  });
</script>
