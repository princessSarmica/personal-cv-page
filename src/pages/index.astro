---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import IntroIslandSection from '../components/IntroIslandSection.astro';
import InBetweenSection1 from '../components/InBetweenSection1.astro';
import ArtIslandSection from '../components/ArtIslandSection.astro';
import ComputerIslandSection from '../components/ComputerIslandSection.astro';
import EducationIslandSection from '../components/EducationIslandSection.astro';
import AchievementIslandSection from '../components/AchievementIslandSection.astro';
import HobbyIslandSection from '../components/HobbyIslandSection.astro';
import BonusIslandSection from '../components/BonusIslandSection.astro';
import OtherIslandSection from '../components/OtherIslandSection.astro';
---

<Layout title="My CV">
  <IntroIslandSection
    id="section-intro"
    name="Name Surname"
    titles="Title 1, Title 2, Title 3"
  />

  <InBetweenSection1
    id="section-in-between-1"
    backgroundImage="/personal-cv-page/images/in_between_section_background_1.webp"
  />

  <EducationIslandSection
    id="section-cs"
    eyebrow="Island 03"
    title="Sit Amet Consectetur"
    text="Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident."
    image="/personal-cv-page/images/education_island_ver3.webp"
    cloudsBackground="/personal-cv-page/images/education_island_clouds_background.webp"
    glitchSquare1Frame1="/personal-cv-page/images/glitch_gray_sq1_1.webp"
    glitchSquare1Frame2="/personal-cv-page/images/glitch_gray_sq1_2.webp"
    glitchSquare1Frame3="/personal-cv-page/images/glitch_gray_sq1_3.webp"
    glitchSquare2Frame1="/personal-cv-page/images/glitch_gray_sq2_1.webp"
    glitchSquare2Frame2="/personal-cv-page/images/glitch_gray_sq2_2.webp"
    glitchSquare2Frame3="/personal-cv-page/images/glitch_gray_sq2_3.webp"
  />

  <ArtIslandSection
    id="section-1"
    eyebrow="Island 01"
    title="Lorem Ipsum Dolor"
    text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam."
    topImage="/personal-cv-page/images/left_top_art_island.webp"
    topImageLoading="/personal-cv-page/images/left_top_art_island_loading_ver2.webp"
    bottomImage="/personal-cv-page/images/right_bottom_art_island.webp"
    bottomImageLoading="/personal-cv-page/images/right_bottom_art_island_loading_ver2.webp"
    moonBackground="/personal-cv-page/images/art_island_moon_background.webp"
    cloudsBackground="/personal-cv-page/images/art_island_clouds_background.webp"
  />

  <ComputerIslandSection
    id="section-cs"
    eyebrow="Island 02"
    title="Sit Amet Consectetur"
    text="Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident."
    leftImage="/personal-cv-page/images/left_powerline_island.webp"
    rightImage="/personal-cv-page/images/computer_island.gif"
    backgroundImage="/personal-cv-page/images/computer_island_background.webp"
  />

  <AchievementIslandSection
    id="section-achievements"
    eyebrow="Island 04"
    title="Do Eiusmod Tempor"
    text="..."
    leftImage="/personal-cv-page/images/left_achievement_island.webp"
    leftImageGlitched="/personal-cv-page/images/left_achievement_island_glitched.webp"
    rightImage="/personal-cv-page/images/right_achievement_island.webp"
    rightImageGlitched="/personal-cv-page/images/right_achievements_island_glitched.webp"
    rightChunk1Image="/personal-cv-page/images/right_achievement_island_first_front_chunk.webp"
    rightChunk2Image="/personal-cv-page/images/right_achievement_island_second_front_chunk.webp"
    backgroundImage="/personal-cv-page/images/achievement_island_background.webp"
  />

  <HobbyIslandSection
    id="section-hobbies"
    eyebrow="Island 05"
    title="Ut Labore Et Dolore"
    text="Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam."
    backIslandImage="/personal-cv-page/images/hobby_back_island.webp"
    frontIslandImage="/personal-cv-page/images/hobby_front_island.webp"
    joyconImage="/personal-cv-page/images/joycon.webp"
    backgroundImage="/personal-cv-page/images/hobby_island_background.webp"
    backIslandFrozenImage="/personal-cv-page/images/hobby_back_island_frozen.webp"
    palmTreeImage="/personal-cv-page/images/palm_tree.webp"
    palmTree80sImage="/personal-cv-page/images/palm_tree_80s.webp"
    monadoImage="/personal-cv-page/images/monado.webp"
    monadoSymbolImages={[
      "/personal-cv-page/images/monado_symbol_1.webp",
      "/personal-cv-page/images/monado_symbol_2.webp",
      "/personal-cv-page/images/monado_symbol_3.webp",
      "/personal-cv-page/images/monado_symbol_4.webp",
      "/personal-cv-page/images/monado_symbol_5.webp",
    ]}
    fountainImage="/personal-cv-page/images/fountain.webp"
  />

  <BonusIslandSection
    id="section-bonus"
    eyebrow="Bonus"
    title="One More Thing"
    text="Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt."
    backgroundImage="/personal-cv-page/images/bonus_island_background.webp"
  />

  <OtherIslandSection
    id="section-closing"
    image="/personal-cv-page/images/other_island_2.webp"
  />
</Layout>