---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import IntroIslandSection from '../components/IntroIslandSection.astro';
import ArtIslandSection from '../components/ArtIslandSection.astro';
import ComputerIslandSection from '../components/ComputerIslandSection.astro';
import EducationIslandSection from '../components/EducationIslandSection.astro';
import AchievementIslandSection from '../components/AchievementIslandSection.astro';
import BonusIslandSection from '../components/BonusIslandSection.astro';
import OtherIslandSection from '../components/OtherIslandSection.astro';
---

<Layout title="My CV">
  <IntroIslandSection
    id="section-intro"
    name="Name Surname"
    titles="Title 1, Title 2, Title 3"
    backgroundImage="/personal-cv-page/images/intro_island_background.webp"
    cloudImage="/personal-cv-page/images/intro_island_cloud_no_smile.webp"
    cloudSmileImage="/personal-cv-page/images/intro_island_cloud_smile.webp"
  />

  <ArtIslandSection
    id="section-1"
    eyebrow="Island 01"
    title="Lorem Ipsum Dolor"
    text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam."
    topImage="/personal-cv-page/images/left_top_art_island.svg"
    topImageLoading="/personal-cv-page/images/left_top_art_island_loading.webp"
    bottomImage="/personal-cv-page/images/right_bottom_art_island.svg"
    bottomImageLoading="/personal-cv-page/images/right_bottom_art_island_loading.webp"
    backgroundImage="/personal-cv-page/images/art_island_background.webp"
  />

  <ComputerIslandSection
    id="section-cs"
    eyebrow="Island 02"
    title="Sit Amet Consectetur"
    text="Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident."
    leftImage="/personal-cv-page/images/left_powerline_island.svg"
    rightImage="/personal-cv-page/images/computer_island.gif"
    backgroundImage="/personal-cv-page/images/computer_island_background.webp"
  />

  <EducationIslandSection
    id="section-cs"
    eyebrow="Island 03"
    title="Sit Amet Consectetur"
    text="Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident."
    bigImage="/personal-cv-page/images/education_island.svg"
    smallImage="/personal-cv-page/images/education_island_small.svg"
    backgroundImage="/personal-cv-page/images/education_island_background.webp"
  />

  <AchievementIslandSection
    id="section-achievements"
    eyebrow="Island 04"
    title="Do Eiusmod Tempor"
    text="..."
    leftImage="/personal-cv-page/images/left_achievement_island.svg"
    leftImageGlitched="/personal-cv-page/images/left_achievement_island_glitched.webp"
    rightImage="/personal-cv-page/images/right_achievement_island.svg"
    rightImageGlitched="/personal-cv-page/images/right_achievements_island_glitched.webp"
    rightChunk1Image="/personal-cv-page/images/right_achievement_island_first_front_chunk.webp"
    rightChunk2Image="/personal-cv-page/images/right_achievement_island_second_front_chunk.webp"
    backgroundImage="/personal-cv-page/images/achievement_island_background.webp"
  />

  <BonusIslandSection
    id="section-bonus"
    eyebrow="Bonus"
    title="One More Thing"
    text="Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt."
    backgroundImage="/personal-cv-page/images/bonus_island_background.webp"
  />

  <OtherIslandSection
    id="section-closing"
    image="/personal-cv-page/images/other_island_2.webp"
  />
</Layout>