---
// src/components/CornerIsland.astro
//
// The persistent "front" island — stays fixed in the bottom-left corner
// across every section as the page scrolls, up through the first half
// of BonusIslandSection (id="section-bonus" in src/pages/index.astro;
// see FREEZE_TARGET_FRACTION / FREEZE_BUFFER_PX in the script below to
// move that stop point). Once it reaches that point it stops tracking
// the viewport and is left behind at that page position instead, so it
// scrolls away normally like any other page content rather than
// continuing to hover in front of the rest of Bonus and
// OtherIslandSection (id="section-closing"), the very last section.
// This is separate from the per-section illustrations in Section.astro,
// which come and go with each section.
//
// Two images live stacked on top of each other inside
// `.corner-island-inner`:
//   - front-island.svg               (default, shown everywhere)
//   - front_island_cartoon_version.webp  (shown only while the user is
//     over HobbyIslandSection, id="section-hobbies")
// One IntersectionObserver (bottom of this file) watches that section
// and toggles the `.is-hobby` class on `.corner-island`, which
// crossfades between the two via opacity transitions. Swap either
// image file in public/images/ with the same filename to update the
// art later; nothing else needs to change.
//
// A second, independent piece of script further down handles the
// "stop partway through BonusIslandSection" behavior described above:
// it measures a point partway down `#section-bonus` (its vertical
// middle by default) and, once you've scrolled that far, swaps
// `.corner-island` from `position: fixed` to `position: absolute` at
// that exact document position via the `.is-frozen` class +
// `--frozen-top` custom property. Scrolling back up past that point
// reverts it to `position: fixed` again, so the behavior works
// smoothly in both scroll directions.
//
// Three nested layers on purpose:
//   .corner-island        — fixed (or, once frozen, absolute) position
//                            + the constant CSS bob loop
//   .corner-island-inner  — the mouse-follow offset (see note below),
//                            and now also the crossfade's positioning
//                            context (position: relative)
//   .corner-island-img*   — the two stacked images themselves
// Keeping these transforms on separate elements from the crossfade
// means none of these animations fight over the same CSS property.
//
// Note: the original file's comment for `.corner-island-inner`
// referenced a mouse-follow script "below" that isn't actually present
// in this file (likely lives elsewhere in the build, or was removed
// before this snippet was captured) — left as-is rather than guessed
// at. Both <script> blocks actually at the bottom of this file are
// new: the hobby-section image swap described above, and the
// freeze-near-end-of-BonusIslandSection behavior.
//
// New: both images below now come from src/images/ via a real import
// instead of a public/images/ URL string, and render with Astro's
// <Image /> component instead of a plain <img> — see the project-wide
// note in src/pages/index.astro's frontmatter for why. Swapping the
// art later now means replacing the file at src/images/front_island.webp
// (or the cartoon version) and keeping the same filename, same as
// before.
import { Image } from 'astro:assets';
import frontIslandImage from '../images/front_island.webp';
import frontIslandCartoonImage from '../images/front_island_cartoon_version.webp';
// The little ghost your friend drew, per your request: sits on the
// island in its still pose (ghost_figure.webp) almost all the time,
// and every so often swaps to its own animated loop
// (ghost_figure_animated.webp -- a gentle side-to-side sway of its
// robe, 8 frames, ~820ms per loop) for a few seconds before fading
// back to still. See `.corner-island-ghost` below for the crossfade
// and the new <script> at the bottom of this file for the "every so
// often" timing.
import ghostFigureImage from '../images/ghost_figure.webp';
import ghostFigureAnimatedImage from '../images/ghost_figure_animated.webp';
---

<div class="corner-island" aria-hidden="true">
  <div class="corner-island-inner">
    <Image
      class="corner-island-img corner-island-img--default"
      src={frontIslandImage}
      alt=""
      loading="eager"
      decoding="async"
    />
    <Image
      class="corner-island-img corner-island-img--hobby"
      src={frontIslandCartoonImage}
      alt=""
      loading="eager"
      decoding="async"
    />

    <div class="corner-island-ghost" aria-hidden="true">
      <Image
        class="corner-island-ghost-img corner-island-ghost-img--static"
        src={ghostFigureImage}
        alt=""
        loading="eager"
        decoding="async"
      />
      <Image
        class="corner-island-ghost-img corner-island-ghost-img--animated"
        src={ghostFigureAnimatedImage}
        alt=""
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</div>

<style>
  .corner-island {
    position: fixed;
    bottom: -6vw;
    left: -10vw;
    width: min(55vw, 900px);
    /* Above SectionTransitionOverlay.astro's whip-pan image
       (z-index: 10000) on purpose, per your request -- this island
       stays visible IN FRONT of that overlay while it sweeps across
       the screen during a nav-menu jump, rather than being covered
       like the rest of the page. IslandNavMenu, GitHubLink and
       LanguageSwitcher now sit one tier above THIS (z-index: 10002,
       per your later request that the nav menu -- and the other two
       corner controls with it -- stay on top of this island whenever
       they get close together), so the final front-to-back order is:
       those three controls, then this island, then the whip-pan
       overlay, then everything else on the page. */
    z-index: 10001;
    pointer-events: none;
    animation: bob 6s ease-in-out infinite;
    /* Per your report that the bob loop (and the ghost riding along
       with it) doesn't look smooth while it's actually playing --
       `will-change` tells the browser to promote this element to its
       own GPU compositor layer UP FRONT and keep it there for as long
       as this rule applies, rather than deciding on the fly whether
       the `animation` above is worth promoting and potentially
       re-layerizing it midway through a loop. This is the standard
       fix for a `transform`-only animation (already the cheapest kind
       -- no layout or paint work, purely the compositor moving an
       existing layer) that still reads as stuttery: on an element
       this large, with several images layered inside it (the island
       art, the hobby crossfade, and now the ghost's own two-image
       crossfade), a layer promotion that keeps getting created and
       torn down is exactly the kind of thing that shows up as
       occasional stutter in an otherwise very slow, very simple
       up/down motion -- and slow motion is precisely where the eye
       notices ANY inconsistency most, unlike a fast animation where
       the same hiccup would likely go unnoticed. */
    will-change: transform;
  }

  /* Freeze state: swaps out of the viewport-relative `fixed`
     positioning above and pins the island at a specific point in the
     DOCUMENT instead, computed by the script below to be partway down
     BonusIslandSection (its vertical middle by default). `bottom` has
     to be explicitly cleared here since the base rule above sets it,
     and a `top` + `bottom` both being non-auto would fight each
     other. */
  .corner-island.is-frozen {
    position: absolute;
    top: var(--frozen-top, auto);
    bottom: auto;
  }

  .corner-island-inner {
    width: 100%;
    /* Positioning context for the absolutely-positioned hobby image
       below — the default image stays in normal flow and is what
       actually gives this element its height. */
    position: relative;
  }

  .corner-island-img {
    display: block;
    width: 100%;
    height: auto;
    /* New: explicit `aspect-ratio` (both files are the same 2242x1442
       size) — Astro's <Image /> defaults to `loading="lazy"` (this
       file never set `loading` explicitly, so that default applies),
       and Chrome specifically warns about a lazy-loaded image whose
       box size isn't pinned down by either fixed width+height or a
       declared `aspect-ratio` — `width: 100%; height: auto;` alone
       leans on the `width`/`height` HTML attributes <Image /> adds as
       a fallback, which Chrome's check doesn't credit. Declaring the
       real ratio here directly satisfies it without changing how this
       already renders. */
    aspect-ratio: 2242 / 1442;
    transition: opacity 0.6s ease;
  }

  /* The default (svg) image drives layout as normal. The hobby (webp)
     image is laid on top of it via absolute positioning so the two
     occupy the exact same box and can crossfade without any layout
     shift. Both start at their "not hobby section" opacity; the
     `.is-hobby` toggle below flips them. */
  .corner-island-img--default {
    opacity: 1;
  }

  .corner-island-img--hobby {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .corner-island.is-hobby .corner-island-img--default {
    opacity: 0;
  }

  .corner-island.is-hobby .corner-island-img--hobby {
    opacity: 1;
  }

  /* The ghost's own little stage on top of the island artwork.
     Positioned as a percentage of `.corner-island-inner`'s own box
     (which is exactly the island artwork's box, per the comment
     above) rather than fixed pixels, so it stays put on the same
     spot of the illustration -- a patch of grass just below the
     snowy peak, one of the few parts of the island that's actually
     still on-screen given `.corner-island`'s own large negative
     `bottom`/`left` offsets above -- at every viewport width the
     island itself renders at. Tuned by eye against the actual
     artwork; nudge `top`/`left` here if your friend's next version
     of the art shifts where that patch of grass sits. */
  .corner-island-ghost {
    position: absolute;
    top: 31%;
    left: 47%;
    width: 19%;
    pointer-events: none;
  }

  .corner-island-ghost-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Same "default drives layout, the alternate is laid on top via
     absolute positioning" split as `.corner-island-img` above -- the
     still pose keeps this box's own size stable (so the animated
     loop crossfading in and out never shifts anything), and the two
     files aren't quite the same aspect ratio (1144x1388 vs the
     animated loop's own 438x560 export), so the overlay gets
     `object-fit: contain` rather than stretching to match the still
     pose's box exactly. */
  .corner-island-ghost-img--static {
    aspect-ratio: 1144 / 1388;
    opacity: 1;
    transition: opacity 0.35s ease;
  }

  .corner-island-ghost-img--animated {
    position: absolute;
    inset: 0;
    /* The static image (1144x1388) and the animated loop (438x560)
       aren't quite the same aspect ratio, so with height left at the
       base class's `auto` this image was sizing itself off its OWN
       intrinsic ratio instead of the static image's box -- slightly
       taller for the same width, which read as "a tiny bit bigger"
       right as the crossfade kicked in. Pinning both width and height
       to 100% (matching the static image's box, which is what actually
       drives `.corner-island-ghost`'s size) and letting `object-fit:
       contain` fit the animated frame inside that exact box fixes it --
       same footprint either way, so the crossfade doesn't shift size. */
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Matching the box wasn't quite enough -- the ghost drawing itself
       sits closer to the edges of its OWN canvas in the animated loop
       (roughly the middle ~68-78% of that 438x560 frame) than in the
       still pose (roughly ~60-72% of the 1144x1388 canvas), so even
       once both canvases are fit into the same box, the animated
       character reads as ~8% bigger than the static one. Both frames
       center the figure the same way, so a plain, uncentered scale-down
       lines the two up: shrinking by that same ~8% here (rather than
       re-exporting the source art) is the quick fix, and safe to revisit
       if the source images ever get re-cropped to match padding. */
    transform: scale(0.92);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  /* `.is-playing` is toggled by the new <script> at the bottom of
     this file on its own "every so often" timer -- nothing to do
     with `.is-hobby` above, the ghost plays its loop regardless of
     which section you're over. */
  .corner-island-ghost.is-playing .corner-island-ghost-img--static {
    opacity: 0;
  }

  .corner-island-ghost.is-playing .corner-island-ghost-img--animated {
    opacity: 1;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (max-width: 700px) {
    .corner-island {
      width: min(90vw, 620px);
      bottom: -12vw;
      left: -14vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .corner-island {
      animation: none;
    }

    /* Still swap images when the hobby section is reached, just
       instantly instead of via an animated fade. */
    .corner-island-img {
      transition: none;
    }

    /* The new <script> below never starts the ghost's "every so
       often" timer at all under reduced motion (see that script's own
       comment), so this never actually fires in practice -- kept
       anyway as the same belt-and-suspenders the rule above already
       is, in case anything else ever toggles `.is-playing`. */
    .corner-island-ghost-img {
      transition: none;
    }
  }
</style>

<script>
  // Swaps the front island's artwork for the cartoon version while the
  // user is scrolled into HobbyIslandSection (id="section-hobbies" in
  // src/components/HomePage.astro), and swaps it back once they scroll
  // past it in either direction. Purely a class toggle — all the
  // actual visual work (crossfade) is the CSS above.
  //
  // rootMargin trims the observer's trigger zone to the vertical
  // center third of the viewport, so the swap happens once the hobby
  // section is meaningfully in view rather than the instant a single
  // pixel of it appears at the very edge of the screen.
  //
  // Wrapped in `astro:page-load` (fires on the initial load AND after
  // every <ClientRouter /> navigation -- see src/layouts/Layout.astro)
  // rather than running at the top level: a language switch replaces
  // both `#section-hobbies` and this very `.corner-island` element
  // with freshly-parsed ones, and this module itself only executes
  // once, so without re-running this init on every navigation the
  // observer would be left watching stale, detached elements after the
  // first language switch. `cleanupHobbySwap` disconnects the previous
  // navigation's observer first.
  let cleanupHobbySwap: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    cleanupHobbySwap?.();

    const hobbySection = document.querySelector("#section-hobbies");
    const cornerIslandForHobby = document.querySelector<HTMLElement>(".corner-island");

    if (hobbySection && cornerIslandForHobby) {
      const hobbyObserver = new IntersectionObserver(
        ([entry]) => {
          cornerIslandForHobby.classList.toggle("is-hobby", entry.isIntersecting);
        },
        { rootMargin: "-33% 0px -33% 0px" }
      );

      hobbyObserver.observe(hobbySection);
      cleanupHobbySwap = () => hobbyObserver.disconnect();
    }
  });
</script>

<script>
  // Stops the fixed front island partway through BonusIslandSection
  // (id="section-bonus" in src/components/HomePage.astro), instead of
  // letting it keep hovering in front of everything all the way down
  // to OtherIslandSection (id="section-closing"), the very last
  // section. The freeze point is FREEZE_TARGET_FRACTION of the way
  // down Bonus's own height, plus an optional extra FREEZE_BUFFER_PX
  // nudge (positive moves the stop point higher up the page, negative
  // moves it lower). Tune either constant to move where exactly it
  // comes to rest.
  //
  // Wrapped in `astro:page-load` (fires on the initial load AND after
  // every <ClientRouter /> navigation -- see src/layouts/Layout.astro)
  // rather than running at the top level: a language switch replaces
  // both `#section-bonus` and this very `.corner-island` element with
  // freshly-parsed ones, and this module itself only executes once, so
  // without re-running this init on every navigation the freeze-on-
  // scroll behavior would be left measuring stale, detached elements
  // after the first language switch. `cleanupFreeze` tears down the
  // previous navigation's `scroll`/`resize`/`load` listeners and
  // pending rAF first, so switching languages back and forth all
  // session never piles up duplicates of any of them running at once
  // (`window` is never recreated by a soft navigation).
  let cleanupFreeze: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    cleanupFreeze?.();

    const controller = new AbortController();
    const { signal } = controller;
    let scrollRafId: number | null = null;

    const FREEZE_TARGET_FRACTION = 0.65;
    // New: mobile gets its own, bigger fraction — `0.85` vs. desktop's
    // `0.65` — so the island keeps tracking the viewport for noticeably
    // longer on narrow screens before it stops, landing further down the
    // page than the desktop/tablet freeze point. Adjust this value
    // directly for still earlier/later on mobile specifically, without
    // touching the desktop/tablet behavior above.
    const FREEZE_TARGET_FRACTION_MOBILE = 0.85;
    const MOBILE_FREEZE_BREAKPOINT = 640;
    const FREEZE_BUFFER_PX = 0;

    const cornerIslandForFreeze = document.querySelector<HTMLElement>(".corner-island");
    const bonusSection = document.querySelector<HTMLElement>("#section-bonus");

    if (cornerIslandForFreeze && bonusSection) {
      let freezeAtScrollY = 0;
      let frozenTopPx = 0;
      let isFrozen = false;

      function applyFrozen() {
        cornerIslandForFreeze!.style.setProperty("--frozen-top", `${frozenTopPx}px`);
        cornerIslandForFreeze!.classList.add("is-frozen");
        isFrozen = true;
      }

      function removeFrozen() {
        cornerIslandForFreeze!.classList.remove("is-frozen");
        isFrozen = false;
      }

      function measure() {
        const wasFrozen = isFrozen;
        if (wasFrozen) removeFrozen();

        // New: pick the active fraction by current viewport width, same
        // `640px` cutoff the rest of the project uses — see the constant
        // declarations' own comment above for why.
        const activeFraction =
          window.innerWidth <= MOBILE_FREEZE_BREAKPOINT
            ? FREEZE_TARGET_FRACTION_MOBILE
            : FREEZE_TARGET_FRACTION;

        const islandTopViewport = cornerIslandForFreeze!.getBoundingClientRect().top;
        const bonusRect = bonusSection!.getBoundingClientRect();
        const bonusTargetDoc =
          bonusRect.top + window.scrollY + bonusRect.height * activeFraction;

        frozenTopPx = bonusTargetDoc - FREEZE_BUFFER_PX;
        freezeAtScrollY = frozenTopPx - islandTopViewport;

        if (wasFrozen) applyFrozen();
      }

      function syncFreezeState() {
        if (!isFrozen && window.scrollY >= freezeAtScrollY) {
          applyFrozen();
        } else if (isFrozen && window.scrollY < freezeAtScrollY) {
          removeFrozen();
        }
      }

      let ticking = false;
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            scrollRafId = requestAnimationFrame(() => {
              syncFreezeState();
              ticking = false;
            });
            ticking = true;
          }
        },
        { passive: true, signal }
      );

      // Re-measure on resize (vw-based sizing means the island's
      // dimensions change with viewport width) and once more on window
      // `load`, in case images above BonusIslandSection finish loading
      // late and shift its position after the initial measurement.
      window.addEventListener("resize", measure, { signal });
      window.addEventListener("load", measure, { signal });

      measure();
      syncFreezeState();
    }

    cleanupFreeze = () => {
      controller.abort();
      if (scrollRafId !== null) cancelAnimationFrame(scrollRafId);
    };
  });
</script>

<script>
  // "Every so often" playback for the ghost's animated loop, per your
  // request. Independent of both other scripts in this file -- it
  // doesn't care whether the island is frozen or which section you're
  // over, just that `.corner-island-ghost` exists at all.
  //
  // Wrapped in `astro:page-load` (fires on the initial load AND after
  // every <ClientRouter /> navigation -- see src/layouts/Layout.astro)
  // rather than running at the top level, for the same reason as the
  // two scripts above: a language switch replaces this very element
  // with a freshly-parsed one, and this module itself only executes
  // once, so without re-running this init on every navigation the
  // ghost would freeze in whichever pose it happened to be in the
  // instant of the first language switch. `cleanupGhostLoop` clears
  // the previous navigation's pending timers first.
  let cleanupGhostLoop: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    cleanupGhostLoop?.();

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const ghost = document.querySelector<HTMLElement>(".corner-island-ghost");
    const animatedImg = ghost?.querySelector<HTMLImageElement>(
      ".corner-island-ghost-img--animated"
    );

    // Reduced motion leaves the ghost sitting in its still pose
    // permanently -- same call this project makes everywhere else
    // (the island's own bob loop, every section's drift/bob
    // animations): this timer exists purely to trigger a decorative
    // animation nobody asked to see, so under that preference it
    // simply never starts.
    if (!ghost || !animatedImg || prefersReducedMotion) {
      cleanupGhostLoop = null;
      return;
    }

    // The animated export's own loop: 8 frames, ~820ms per full loop
    // (measured directly from the file's ANMF chunk durations, not
    // guessed), looping forever on its own once it's playing --
    // there's no "play once and stop" built into an animated WebP, so
    // how many loops it plays is entirely down to how long WE keep
    // `.is-playing` on before fading back, below.
    const LOOP_MS = 820;
    const PLAY_LOOPS = 2;
    const PLAY_MS = LOOP_MS * PLAY_LOOPS;

    // How long the ghost sits still between appearances -- randomized
    // per cycle (rather than one fixed interval) so it reads as the
    // ghost occasionally doing something on its own, not a metronome.
    const IDLE_MIN_MS = 8000;
    const IDLE_MAX_MS = 16000;

    function randomIdleMs() {
      return IDLE_MIN_MS + Math.random() * (IDLE_MAX_MS - IDLE_MIN_MS);
    }

    let idleTimer: number | undefined;
    let playTimer: number | undefined;

    function scheduleNextPlay() {
      idleTimer = window.setTimeout(playOnce, randomIdleMs());
    }

    function playOnce() {
      // Forces the animated WebP to (re)start from its very first
      // frame: reassigning `.src` to its own current value makes the
      // browser redo the image-loading algorithm from scratch, even
      // though the URL hasn't actually changed, which resets an
      // animated image's own playback position -- the same trick
      // widely used to restart an animated GIF on demand. Without
      // this, the crossfade-in above would reveal the loop wherever
      // its own internal timer already happened to be (it never
      // actually stops advancing just because `opacity` is 0),
      // instead of always starting the sway from the same, deliberate
      // first frame.
      animatedImg!.src = animatedImg!.src;
      ghost!.classList.add("is-playing");

      playTimer = window.setTimeout(() => {
        ghost!.classList.remove("is-playing");
        scheduleNextPlay();
      }, PLAY_MS);
    }

    scheduleNextPlay();

    cleanupGhostLoop = () => {
      window.clearTimeout(idleTimer);
      window.clearTimeout(playTimer);
    };
  });
</script>