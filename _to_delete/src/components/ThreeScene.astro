---
// src/components/ThreeScene.astro
//
// First Three.js pass for the site. Wired up exactly the way every
// other bit of interactivity here already works: plain markup + a
// <script> tag that Astro/Vite bundles for the client, no framework
// island needed — `three` is just an npm dependency like `gsap`
// already is (see package.json), imported directly.
//
// Renders one lit, slowly rotating shape into <canvas class="three-canvas">
// — a placeholder stand-in for a future "3D island" model. Swap the
// IcosahedronGeometry block below for a loaded GLTF model whenever
// there's real art for it (see the comment right above `mesh`).
//
// Respects prefers-reduced-motion the same way IntroIslandSection /
// CornerIsland do: motion just stops, the scene still renders one
// static frame instead of not rendering at all.
//
// Usage:
//   <ThreeScene id="section-three-demo" />

interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<section class="three-scene-section" id={id}>
  <canvas class="three-canvas" aria-hidden="true"></canvas>
</section>

<script>
  import * as THREE from "three";

  const canvas = document.querySelector<HTMLCanvasElement>(".three-canvas");
  const section = canvas?.closest<HTMLElement>(".three-scene-section");

  if (canvas && section) {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(
      45,
      section.clientWidth / section.clientHeight,
      0.1,
      100
    );
    camera.position.set(0, 0, 6);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true, // lets the page's own sky/background show through
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(section.clientWidth, section.clientHeight);

    // Placeholder geometry. To swap in a real island model later:
    //   import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
    //   new GLTFLoader().load(
    //     "/personal-cv-page/models/island.glb",
    //     (gltf) => scene.add(gltf.scene)
    //   );
    const geometry = new THREE.IcosahedronGeometry(1.6, 1);
    const material = new THREE.MeshStandardMaterial({
      color: 0x3a6ef5, // matches --sky-1 elsewhere in the page
      flatShading: true,
    });
    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    const keyLight = new THREE.DirectionalLight(0xffffff, 1.2);
    keyLight.position.set(3, 4, 5);
    scene.add(keyLight);

    function resize() {
      const { clientWidth: w, clientHeight: h } = section!;
      if (w === 0 || h === 0) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }
    window.addEventListener("resize", resize);

    let frameId: number;
    function tick() {
      if (!prefersReducedMotion) {
        mesh.rotation.x += 0.004;
        mesh.rotation.y += 0.006;
      }
      renderer.render(scene, camera);
      frameId = requestAnimationFrame(tick);
    }
    tick();

    // Belt-and-braces cleanup — a no-op on this plain multi-page site
    // today, but cheap insurance if Astro view transitions (persisted
    // DOM across "pages") ever get turned on for this project.
    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(frameId);
        window.removeEventListener("resize", resize);
        renderer.dispose();
        geometry.dispose();
        material.dispose();
      },
      { once: true }
    );
  }
</script>

<style>
  .three-scene-section {
    position: relative;
    height: min(70vh, 640px);
    width: 100%;
  }

  .three-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
